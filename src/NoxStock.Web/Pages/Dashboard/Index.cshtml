@page
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Localization
@model NoxStock.Web.Pages.Dashboard.IndexModel
@inject IHtmlLocalizer<NoxStockResource> L
@{
    Layout = "_AppLayout";
    ViewData["Title"] = L["Dashboard:Overview"].Value;
}

<div class="mb-8">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-white">@L["Dashboard:Overview"]</h2>
    <p class="text-sm text-slate-500 mt-1">@L["Dashboard:Description"]</p>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    
    <!-- Stat 1 -->
    <div class="card p-6 flex items-center shadow-lg shadow-indigo-500/5">
        <div class="p-3 rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400 mr-4">
            <span class="material-icons-round text-3xl">payments</span>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L["Dashboard:TodaySales"]</p>
            <p class="text-2xl font-bold text-slate-800 dark:text-white">@Model.FormatMoney(Model.Summary.TodaySales)</p>
        </div>
    </div>

    <!-- Stat 2 -->
    <div class="card p-6 flex items-center shadow-lg shadow-emerald-500/5">
        <div class="p-3 rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400 mr-4">
            <span class="material-icons-round text-3xl">inventory_2</span>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L["Dashboard:CriticalStockAlerts"]</p>
            <p class="text-2xl font-bold text-slate-800 dark:text-white">@Model.Summary.CriticalStockCount @L["Dashboard:Product"]</p>
        </div>
    </div>

    <!-- Stat 3 -->
    <div class="card p-6 flex items-center shadow-lg shadow-blue-500/5">
        <div class="p-3 rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400 mr-4">
            <span class="material-icons-round text-3xl">people</span>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L["Dashboard:ActiveCustomers"]</p>
            <p class="text-2xl font-bold text-slate-800 dark:text-white">@Model.Summary.ActiveCustomerCount</p>
        </div>
    </div>

    <!-- Stat 4 -->
    <div class="card p-6 flex items-center shadow-lg shadow-orange-500/5">
        <div class="p-3 rounded-xl bg-orange-50 text-orange-600 dark:bg-orange-500/10 dark:text-orange-400 mr-4">
            <span class="material-icons-round text-3xl">receipt_long</span>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L["Dashboard:PendingInvoices"]</p>
            <p class="text-2xl font-bold text-slate-800 dark:text-white">@Model.Summary.PendingInvoiceCount @L["Dashboard:Count"]</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L["Dashboard:MonthlyRevenue"]</p>
        <p class="text-2xl font-bold text-slate-800 dark:text-white mt-2">@Model.FormatMoney(Model.Summary.MonthlyRevenue)</p>
    </div>
    <div class="card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L["Dashboard:AccountBalance"]</p>
        <p class="text-2xl font-bold text-slate-800 dark:text-white mt-2">@Model.FormatMoney(Model.Summary.TotalAccountBalance)</p>
    </div>
    <div class="card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L["Dashboard:CustomerReceivables"]</p>
        <p class="text-2xl font-bold text-slate-800 dark:text-white mt-2">@Model.FormatMoney(Model.Summary.CustomerReceivables)</p>
    </div>
    <div class="card p-6">
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L["Dashboard:NetPosition"]</p>
        <p class="text-2xl font-bold text-slate-800 dark:text-white mt-2">@Model.FormatMoney(Model.Summary.NetPosition)</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="card p-6 lg:col-span-2">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-slate-800 dark:text-white">@L["Dashboard:MonthlySalesChart"]</h3>
            <span class="text-xs text-slate-500">@L["Dashboard:LastSixMonths"]</span>
        </div>
        <div class="h-64 rounded-lg bg-slate-50 dark:bg-slate-800/50 px-4 pt-6 pb-3">
            @if (Model.Summary.SalesTrend.All(x => x.Total == 0))
            {
                <div class="h-full flex flex-col items-center justify-center text-slate-400">
                    <span class="material-icons-round text-4xl mb-2 opacity-50">bar_chart</span>
                    <p class="text-sm">@L["Dashboard:ChartNoData"]</p>
                </div>
            }
            else
            {
                <div class="h-full flex items-end justify-between gap-3">
                    @foreach (var point in Model.Summary.SalesTrend)
                    {
                        <div class="h-full flex-1 min-w-0 flex flex-col justify-end items-center gap-2">
                            <span class="text-xs font-medium text-slate-500 whitespace-nowrap">@Model.FormatCompactMoney(point.Total)</span>
                            <div class="w-full max-w-12 rounded-t bg-indigo-500 dark:bg-indigo-400" style="height: @Model.GetSalesTrendHeight(point.Total)" title="@point.Label: @Model.FormatMoney(point.Total)"></div>
                            <span class="text-xs text-slate-500 uppercase">@point.Label</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card p-6">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-slate-800 dark:text-white">@L["Dashboard:RecentTransactions"]</h3>
        </div>
        @if (Model.Summary.RecentDocuments.Count == 0)
        {
            <div class="h-full flex flex-col items-center justify-center text-slate-400 py-8">
                <span class="material-icons-round text-4xl mb-2 opacity-50">receipt_long</span>
                <p class="text-sm">@L["Dashboard:NoTransactions"]</p>
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var document in Model.Summary.RecentDocuments)
                {
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-white">@document.DocNumber</p>
                            <p class="text-xs text-slate-500">@document.BusinessPartnerName</p>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-bold text-slate-800 dark:text-white">@Model.FormatMoney(document.GrandTotal)</p>
                            <p class="text-xs text-slate-500">@document.Status</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
    <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="text-lg font-bold text-slate-800 dark:text-white">@L["Dashboard:CriticalStocks"]</h3>
                <p class="text-xs text-slate-500 mt-1">@L["Dashboard:CriticalStockDescription"]</p>
            </div>
            <a href="~/Products" class="text-indigo-600 text-sm font-medium hover:underline">@L["Menu:Products"]</a>
        </div>
        @if (Model.Summary.CriticalStocks.Count == 0)
        {
            <div class="py-8 text-center text-slate-400">
                <span class="material-icons-round text-4xl mb-2 opacity-50">inventory_2</span>
                <p class="text-sm">@L["Dashboard:NoCriticalStock"]</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var product in Model.Summary.CriticalStocks)
                {
                    <div class="flex items-center justify-between py-3 first:pt-0">
                        <div class="min-w-0 pr-4">
                            <p class="truncate text-sm font-semibold text-slate-800 dark:text-white">@product.Name</p>
                            <p class="text-xs text-slate-500">@product.Sku</p>
                        </div>
                        <div class="text-right whitespace-nowrap">
                            <p class="text-sm font-bold text-rose-600 dark:text-rose-400">@Model.FormatQuantity(product.Quantity) @product.Unit</p>
                            <p class="text-xs text-slate-500">@L["Dashboard:Critical"]: @Model.FormatQuantity(product.CriticalStockLevel)</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="text-lg font-bold text-slate-800 dark:text-white">@L["Dashboard:TopProducts"]</h3>
                <p class="text-xs text-slate-500 mt-1">@L["Dashboard:TopProductsDescription"]</p>
            </div>
            <a href="~/Reports" class="text-indigo-600 text-sm font-medium hover:underline">@L["Menu:Reports"]</a>
        </div>
        @if (Model.Summary.TopProducts.Count == 0)
        {
            <div class="py-8 text-center text-slate-400">
                <span class="material-icons-round text-4xl mb-2 opacity-50">leaderboard</span>
                <p class="text-sm">@L["Dashboard:NoSalesData"]</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var product in Model.Summary.TopProducts)
                {
                    <div class="flex items-center justify-between py-3 first:pt-0">
                        <div class="min-w-0 pr-4">
                            <p class="truncate text-sm font-semibold text-slate-800 dark:text-white">@product.Name</p>
                            <p class="text-xs text-slate-500">@product.Sku · @Model.FormatQuantity(product.Quantity) @L["Dashboard:Unit"]</p>
                        </div>
                        <p class="whitespace-nowrap text-sm font-bold text-slate-800 dark:text-white">@Model.FormatMoney(product.Revenue)</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card p-6 mt-6">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h3 class="text-lg font-bold text-slate-800 dark:text-white">@L["Dashboard:DueInvoices"]</h3>
            <p class="text-xs text-slate-500 mt-1">@L["Dashboard:DueInvoicesDescription"]</p>
        </div>
        <a href="~/Invoices" class="text-indigo-600 text-sm font-medium hover:underline">@L["Menu:Invoices"]</a>
    </div>
    @if (Model.Summary.DueDocuments.Count == 0)
    {
        <div class="py-8 text-center text-slate-400">
            <span class="material-icons-round text-4xl mb-2 opacity-50">event_available</span>
            <p class="text-sm">@L["Dashboard:NoDueInvoices"]</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-700">
                        <th class="pb-3 text-xs font-semibold uppercase text-slate-500">@L["Dashboard:Invoice"]</th>
                        <th class="pb-3 text-xs font-semibold uppercase text-slate-500">@L["Dashboard:BusinessPartner"]</th>
                        <th class="pb-3 text-xs font-semibold uppercase text-slate-500">@L["Dashboard:DueDate"]</th>
                        <th class="pb-3 text-xs font-semibold uppercase text-slate-500 text-right">@L["Dashboard:Outstanding"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                    @foreach (var document in Model.Summary.DueDocuments)
                    {
                        var isOverdue = document.DueDate.Date < DateTime.Today;
                        <tr>
                            <td class="py-3 text-sm font-semibold text-slate-800 dark:text-white">@document.DocNumber</td>
                            <td class="py-3 text-sm text-slate-600 dark:text-slate-300">@document.BusinessPartnerName</td>
                            <td class="py-3 text-sm @(isOverdue ? "font-semibold text-rose-600 dark:text-rose-400" : "text-slate-600 dark:text-slate-300")">@document.DueDate.ToString("dd.MM.yyyy")</td>
                            <td class="py-3 text-right text-sm font-bold text-slate-800 dark:text-white">@Model.FormatMoney(document.OutstandingAmount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
