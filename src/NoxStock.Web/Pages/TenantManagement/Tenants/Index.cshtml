@page
@using NoxStock.MultiTenancy
@model NoxStock.Web.Pages.TenantManagement.Tenants.IndexModel
@{
    ViewData["Title"] = "Şirketler";
}

<div class="space-y-6">
    @if (TempData["TenantStatusMessage"] is string tenantStatusMessage)
    {
        <div class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">@tenantStatusMessage</div>
    }

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900 dark:text-white">Şirketler</h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">NoxStock çalışma alanlarını ve yönetici girişlerini yönetin.</p>
        </div>
        <button id="NewTenantButton" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700">
            <span class="material-icons-round text-base">add</span>
            Yeni şirket
        </button>
    </div>

    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[680px] text-left text-sm">
                <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
                    <tr>
                        <th class="px-6 py-4">Şirket</th>
                        <th class="px-6 py-4">Durum</th>
                        <th class="px-6 py-4">Oluşturulma</th>
                        <th class="px-6 py-4 text-right">Yönetim</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                    @if (Model.Tenants.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-14 text-center text-sm text-slate-500 dark:text-slate-400">Henüz şirket bulunmuyor.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var tenant in Model.Tenants)
                        {
                            var isActive = tenant.IsNoxStockActive();
                            <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                <td class="px-6 py-4">
                                    <div class="font-semibold text-slate-900 dark:text-white">@tenant.Name</div>
                                    <div class="mt-0.5 font-mono text-xs text-slate-500">/t/@tenant.Name</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(isActive ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300" : "bg-rose-100 text-rose-700 dark:bg-rose-500/15 dark:text-rose-300")">
                                        @(isActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-600 dark:text-slate-300">@tenant.CreationTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        <form method="post" asp-page-handler="SetActive">
                                            <input type="hidden" name="tenantId" value="@tenant.Id" />
                                            <input type="hidden" name="isActive" value="@(!isActive ? "true" : "false")" />
                                            <button type="submit" class="font-semibold @(isActive ? "text-rose-600 hover:text-rose-800" : "text-emerald-600 hover:text-emerald-800")" data-tenant-name="@tenant.Name" data-tenant-action="@(isActive ? "deactivate" : "activate")">
                                                @(isActive ? "Pasife al" : "Etkinleştir")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <abp-script src="/Pages/TenantManagement/Tenants/Index.js" />
}
