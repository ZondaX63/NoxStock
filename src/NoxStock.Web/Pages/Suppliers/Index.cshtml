@page
@using Microsoft.AspNetCore.Mvc.Localization
@model NoxStock.Web.Pages.Suppliers.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Tedarikçiler";
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-white sm:text-3xl">Tedarikçiler</h2>
        <p class="text-sm text-slate-500 mt-1">Tedarikçi listesini ve cari hesaplarını yönetin.</p>
    </div>
    <button id="NewSupplierButton" type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-md font-medium transition-colors flex items-center justify-center">
        <span class="material-icons-round mr-2 text-sm">add</span>
        Yeni Tedarikçi Ekle
    </button>
</div>

<div class="card overflow-hidden">
    <div class="p-6">
        <div class="overflow-x-auto">
            <table id="SuppliersTable" class="table w-full text-left whitespace-nowrap">
                <thead>
                    <tr>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">İşlemler</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Adı Soyadı / Ünvan</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Telefon</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Vadesi Geçmiş</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Son Alış</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Son Ödeme</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Borcumuz</th>
                    </tr>
                </thead>
                <tbody class="text-sm">
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <abp-script src="/Pages/Shared/PaymentModal.js" />
    <abp-script src="/Pages/Shared/BusinessPartnerOpeningBalanceModal.js" />
    <abp-script src="/Pages/Suppliers/Index.js" />
}
