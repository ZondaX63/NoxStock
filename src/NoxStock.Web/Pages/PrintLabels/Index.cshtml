@page
@model NoxStock.Web.Pages.PrintLabels.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Etiket Yazdır";
}

<div class="no-print mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div><h2 class="text-2xl font-bold text-slate-800 dark:text-white">Etiket Yazdır</h2><p class="mt-1 text-sm text-slate-500">Ürünleri seçin ve yazdırma önizlemesini hazırlayın.</p></div>
    <button id="PrintLabelsButton" type="button" class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-indigo-600 px-4 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700"><span class="material-icons-round text-base">print</span>Yazdır</button>
</div>

<div class="no-print grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
    <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="border-b border-slate-200 p-5 dark:border-slate-700">
            <label for="LabelSearch" class="sr-only">Ürün ara</label>
            <div class="relative"><span class="material-icons-round absolute left-3 top-2.5 text-base text-slate-400">search</span><input id="LabelSearch" type="search" autocomplete="off" class="w-full rounded-md border border-slate-300 bg-white py-2 pl-9 pr-3 text-sm text-slate-800 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:border-slate-600 dark:bg-slate-900 dark:text-white" placeholder="Ürün adı, stok kodu veya barkod ara" /></div>
        </div>
        <div class="max-h-72 overflow-y-auto"><table class="w-full text-left text-sm"><thead class="sticky top-0 bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-900"><tr><th class="w-12 px-4 py-3"></th><th class="px-4 py-3">Ürün</th><th class="px-4 py-3">Kod</th><th class="px-4 py-3 text-right">Fiyat</th></tr></thead><tbody id="LabelProductResults"></tbody></table></div>
        <div class="border-t border-slate-200 dark:border-slate-700"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-900"><tr><th class="px-4 py-3">Yazdırma kuyruğu</th><th class="w-32 px-4 py-3 text-right">Adet</th><th class="w-12 px-4 py-3"></th></tr></thead><tbody id="LabelQueue" class="divide-y divide-slate-100 dark:divide-slate-700"></tbody></table></div>
    </section>

    <aside class="h-fit overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="space-y-5 p-5">
            <div><label for="LabelFormat" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Kod tipi</label><select id="LabelFormat" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900"><option value="barcode" selected="@(Model.DefaultLabelFormat == "barcode")">Barkod</option><option value="qr" selected="@(Model.DefaultLabelFormat == "qr")">QR</option></select></div>
            <div><label for="LabelAddQuantity" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Eklenecek adet</label><input id="LabelAddQuantity" type="number" min="1" max="100" value="1" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900" /></div>
            <div class="space-y-3 border-t border-slate-200 pt-4 dark:border-slate-700"><label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300"><input id="LabelShowName" type="checkbox" checked class="rounded border-slate-300 text-indigo-600" />Ürün adı</label><label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300"><input id="LabelShowPrice" type="checkbox" checked class="rounded border-slate-300 text-indigo-600" />Satış fiyatı</label></div>
        </div>
    </aside>
</div>

<section class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <div class="no-print border-b border-slate-200 px-5 py-4 dark:border-slate-700"><h3 class="font-semibold text-slate-800 dark:text-white">Yazdırma Önizlemesi</h3></div>
    <div id="LabelPreview" class="label-preview-grid p-5"></div>
</section>

@section Scripts {
    <script src="~/libs/jsbarcode/JsBarcode.all.min.js" asp-append-version="true"></script>
    <script src="~/libs/qrcodejs/qrcode.min.js" asp-append-version="true"></script>
    <abp-script src="/Pages/PrintLabels/Index.js" />
}

@section Styles {
    <style>
        .label-preview-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px}.print-label{height:120px;overflow:hidden;border:1px dashed #94a3b8;padding:8px;color:#0f172a;background:#fff}.print-label-name{height:34px;overflow:hidden;font-size:12px;font-weight:700;line-height:17px}.print-label-price{font-size:13px;font-weight:700;text-align:right}.print-label-code{height:52px;display:flex;align-items:center;justify-content:center}.print-label-code svg{max-width:100%;max-height:48px}.print-label-code canvas{width:50px!important;height:50px!important}@@media print{.no-print,header,aside{display:none!important}main{padding:0!important;overflow:visible!important}.label-preview-grid{grid-template-columns:repeat(4,1fr);gap:4mm;padding:0!important}.print-label{height:25mm;border:0;padding:1mm;break-inside:avoid}.print-label-code{height:12mm}.print-label-code svg{max-height:11mm}.print-label-code canvas{width:11mm!important;height:11mm!important}.print-label-name{height:7mm;font-size:8pt;line-height:3.3mm}.print-label-price{font-size:8pt}}
    </style>
}
