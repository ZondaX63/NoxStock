@page
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NoxStock.Web.Pages.Shared.BusinessPartnerOpeningBalanceModalModel
@{ Layout = null; }

<form asp-page="/Shared/BusinessPartnerOpeningBalanceModal" class="finance-modal-form">
    <abp-modal>
        <abp-modal-header title="Cari Açılış Bakiyesi"></abp-modal-header>
        <abp-modal-body class="finance-modal-body">
            <input type="hidden" asp-for="Opening.BusinessPartnerId" />
            <input type="hidden" asp-for="Opening.OperationKey" />
            <div class="finance-modal-intro finance-modal-intro-indigo">
                <div><strong>@Model.Partner.Name</strong><small>@Model.Partner.Currency · Mevcut durum: @Model.Partner.Balance.ToString("N2")</small></div>
            </div>
            @if (Model.Partner.Balance != 0m)
            {
                <div class="alert alert-warning py-2">Bu carinin mevcut bakiyesi var. Açılış tutarı mevcut bakiyeye eklenecektir.</div>
            }
            <div class="finance-form-grid">
                <abp-select asp-for="Opening.Direction" asp-items="Model.Directions" label="Yön" />
                <abp-input asp-for="Opening.Amount" label="Tutar" type="text" inputmode="decimal" />
                <abp-input asp-for="Opening.OpeningDate" label="Açılış tarihi" />
                <div class="finance-field-wide"><abp-input asp-for="Opening.Description" label="Açıklama" /></div>
            </div>
            <div id="PartnerOpeningPreview" class="mt-3 rounded-lg border border-indigo-100 bg-indigo-50 p-3 text-sm" data-current="@Model.Partner.Balance" data-currency="@Model.Partner.Currency">
                İşlem sonrası durum: <strong>—</strong>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
