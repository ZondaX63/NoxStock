@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Users
@using System.Globalization
@inject ICurrentUser CurrentUser

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="noxstock-correlation-id" content="@Context.TraceIdentifier" />
    <meta name="theme-color" content="#111827" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <title>@ViewData["Title"] - NoxStock</title>

    <script>
        (function () {
            var savedTheme = localStorage.getItem('noxstock.theme') || (localStorage.getItem('darkMode') === 'true' ? 'dark' : 'light');
            var root = document.documentElement;
            root.classList.toggle('dark', savedTheme === 'dark');
            root.classList.add('nox-page-loading');
            var fallbackTimer;

            function finishPageLoad() {
                window.clearTimeout(fallbackTimer);
                window.requestAnimationFrame(function () {
                    window.requestAnimationFrame(function () {
                        root.classList.remove('nox-page-loading');
                    });
                });
            }

            // Wait for blocking page assets as well as the HTML. The fallback
            // keeps a slow/failed asset from leaving the whole application
            // behind a loader indefinitely.
            fallbackTimer = window.setTimeout(finishPageLoad, 1800);
            window.addEventListener('load', finishPageLoad, { once: true });
            window.addEventListener('pageshow', finishPageLoad);

            // Show the loader before a normal internal navigation starts. This
            // prevents the old page from flashing while the next Razor Page is
            // being requested and rendered.
            document.addEventListener('click', function (event) {
                if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                var link = event.target.closest && event.target.closest('a[href]');
                if (!link || link.target === '_blank' || link.hasAttribute('download') || link.dataset.bsToggle || link.dataset.toggle) return;
                var href = link.getAttribute('href');
                if (!href || href.charAt(0) === '#' || href.indexOf('javascript:') === 0) return;
                var url;
                try { url = new URL(link.href, window.location.href); } catch (_) { return; }
                if (url.origin !== window.location.origin || (url.pathname === window.location.pathname && url.search === window.location.search)) return;
                root.classList.add('nox-page-loading');
            }, true);
        })();
    </script>

    <!-- Outfit Font -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">

    <!-- Alpine.js for lightweight interactions (Modals, Dropdowns) -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        html.dark ::-webkit-scrollbar-thumb {
            background: #475569;
        }
        /* Hide scrollbar for sidebar */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>

    <abp-style-bundle name="@Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite.Bundling.LeptonXLiteThemeBundles.Styles.Global" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans antialiased transition-colors duration-200" x-data="{ sidebarOpen: false, darkMode: false }" x-init="darkMode = document.documentElement.classList.contains('dark'); $watch('darkMode', val => { localStorage.setItem('darkMode', val); localStorage.setItem('noxstock.theme', val ? 'dark' : 'light'); document.documentElement.classList.toggle('dark', val); });">

    <div id="NoxPageSkeleton" class="nox-page-skeleton" aria-hidden="true">
        <div class="nox-page-skeleton-sidebar"><span class="nox-skeleton-logo"></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="nox-page-skeleton-content">
            <div class="nox-page-skeleton-topbar"><span></span><span></span><span></span></div>
            <div class="nox-page-skeleton-heading"><span></span><span></span></div>
            <div class="nox-page-skeleton-card"><span></span><span></span><span></span><span></span></div>
            <div class="nox-page-skeleton-card nox-page-skeleton-card-short"><span></span><span></span><span></span></div>
        </div>
    </div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar ViewComponent -->
        @await Component.InvokeAsync("AppSidebar")

        <div class="flex-1 flex flex-col overflow-hidden">
            
            <!-- Topbar ViewComponent -->
            @await Component.InvokeAsync("AppTopbar")

            <!-- Main Content -->
            <main class="app-main flex-1 overflow-x-hidden overflow-y-auto transition-colors duration-200 relative">
                <div class="app-content-frame">
                    <div class="mb-4">
                        <abp-page-alerts />
                    </div>
                    <div id="AbpContentToolbar">
                        @await RenderSectionAsync("content_toolbar", required: false)
                    </div>
                    @RenderBody()
                </div>
            </main>
            
        </div>

        <!-- Mobile Sidebar Overlay -->
        <div x-show="sidebarOpen" 
             x-transition:enter="transition-opacity ease-linear duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity ease-linear duration-300"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 z-20 bg-black/50 backdrop-blur-sm lg:hidden"
             @@click="sidebarOpen = false"
             style="display: none;">
        </div>

    </div>

    <abp-script-bundle name="@Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite.Bundling.LeptonXLiteThemeBundles.Scripts.Global" />
    <script src="~/Abp/ApplicationConfigurationScript"></script>
    <script>
        // ABP derives appPath from App:SelfUrl, but tenant routes use a per-request PathBase.
        abp.appPath = '@(Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value!.TrimEnd('/') + "/" : "/")';
    </script>
    <script src="~/Abp/ApplicationLocalizationScript?cultureName=@CultureInfo.CurrentUICulture.Name"></script>
    <script src="~/Abp/ServiceProxyScript"></script>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
