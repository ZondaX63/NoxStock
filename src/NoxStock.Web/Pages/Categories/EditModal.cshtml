@page
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IHtmlLocalizer<NoxStockResource> L
@model NoxStock.Web.Pages.Categories.EditModalModel
@{
    Layout = null;
}

<form asp-page="/Categories/EditModal">
    <abp-modal>
        <abp-modal-header title="@L["Update"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-input asp-for="Category.Name" />
            <abp-select asp-for="Category.ParentId" asp-items="Model.Categories" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
