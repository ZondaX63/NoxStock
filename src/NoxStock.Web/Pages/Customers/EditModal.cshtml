@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NoxStock.Web.Pages.Customers.EditModalModel
@{
    Layout = null;
}

<form asp-page="/Customers/EditModal">
    <abp-modal>
        <abp-modal-header title="Müşteri Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-input asp-for="Customer.Name" label="Adı Soyadı / Ünvan" />
            <abp-input asp-for="Customer.Email" label="E-Posta" />
            <abp-input asp-for="Customer.Phone" label="Telefon" />
            <abp-input asp-for="Customer.TaxOffice" label="Vergi Dairesi" />
            <abp-input asp-for="Customer.TaxNumber" label="Vergi Numarası / TCKN" />
            <abp-input asp-for="Customer.Address" label="Adres" />
            <abp-input asp-for="Customer.CreditLimit" label="Kredi Limiti" />
            <abp-input asp-for="Customer.Currency" label="Para Birimi" />
            <div class="mt-4 border-top pt-3">
                <label class="form-label fw-semibold">Varsayılan satış iskontoları (%)</label>
                <small class="d-block text-muted mb-2">Yeni satış faturalarında satıra başlangıç değeri olarak gelir; faturada değiştirilebilir.</small>
                <div class="row g-2">
                    <div class="col-6 col-md-3"><abp-input asp-for="Customer.DefaultSalesDiscount1" label="İsk. 1" /></div>
                    <div class="col-6 col-md-3"><abp-input asp-for="Customer.DefaultSalesDiscount2" label="İsk. 2" /></div>
                    <div class="col-6 col-md-3"><abp-input asp-for="Customer.DefaultSalesDiscount3" label="İsk. 3" /></div>
                    <div class="col-6 col-md-3"><abp-input asp-for="Customer.DefaultSalesDiscount4" label="İsk. 4" /></div>
                </div>
            </div>
            <input type="hidden" asp-for="Customer.Type" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
