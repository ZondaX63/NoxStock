@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NoxStock.Web.Pages.Customers.CreateModalModel
@{
    Layout = null;
}

<form asp-page="/Customers/CreateModal">
    <abp-modal modal-class="business-partner-modal">
        <abp-modal-header title="Yeni Müşteri Ekle"></abp-modal-header>
        <abp-modal-body>
            <div class="partner-form-intro"><strong>Müşteri kartını oluşturun</strong><span>İletişim, cari limit ve satış varsayımlarını tek ekrandan tanımlayın.</span></div>
            <section class="partner-form-section">
                <div class="partner-form-section-heading"><strong>Kimlik ve iletişim</strong><span>Arama ve fatura için kullanılır</span></div>
                <div class="row g-3"><div class="col-12"><abp-input asp-for="Customer.Name" label="Adı Soyadı / Ünvan" /></div><div class="col-md-6"><abp-input asp-for="Customer.Phone" label="Telefon" /></div><div class="col-md-6"><abp-input asp-for="Customer.Email" label="E-Posta" /></div></div>
            </section>
            <section class="partner-form-section">
                <div class="partner-form-section-heading"><strong>Vergi ve adres bilgileri</strong><span>Opsiyonel</span></div>
                <div class="row g-3"><div class="col-md-6"><abp-input asp-for="Customer.TaxOffice" label="Vergi Dairesi" /></div><div class="col-md-6"><abp-input asp-for="Customer.TaxNumber" label="Vergi Numarası / TCKN" /></div><div class="col-12"><abp-input asp-for="Customer.Address" label="Adres" /></div></div>
            </section>
            <section class="partner-form-section">
                <div class="partner-form-section-heading"><strong>Ticari varsayılanlar</strong><span>Limit, 0 ise sınırsızdır</span></div>
                <div class="row g-3"><div class="col-md-6"><abp-input asp-for="Customer.CreditLimit" label="Kredi Limiti" /></div><div class="col-md-6"><abp-input asp-for="Customer.Currency" label="Para Birimi" /></div></div>
                <div class="partner-limit-note">Limit tanımlıysa yeni satışlarda cari bakiye bu limiti aşamaz.</div>
            </section>
            <section class="partner-form-section">
                <div class="partner-form-section-heading"><strong>Varsayılan satış iskontoları (%)</strong><span>Fatura satırında değiştirilebilir</span></div>
                <div class="row g-2">
                    <div class="col-6 col-md-3"><abp-input asp-for="Customer.DefaultSalesDiscount1" label="İsk. 1" /></div>
                    <div class="col-6 col-md-3"><abp-input asp-for="Customer.DefaultSalesDiscount2" label="İsk. 2" /></div>
                    <div class="col-6 col-md-3"><abp-input asp-for="Customer.DefaultSalesDiscount3" label="İsk. 3" /></div>
                    <div class="col-6 col-md-3"><abp-input asp-for="Customer.DefaultSalesDiscount4" label="İsk. 4" /></div>
                </div>
            </section>
            <input type="hidden" asp-for="Customer.Type" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
