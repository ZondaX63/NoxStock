@page "{id?}"
@using NoxStock.Documents
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Localization
@model NoxStock.Web.Pages.Invoices.CreateModel
@inject IHtmlLocalizer<NoxStockResource> L
@{
    Layout = "_AppLayout";
    var title = Model.GetDocumentTitle();
    ViewData["Title"] = title;
}

<div class="invoice-page-shell">
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-white sm:text-3xl">@title</h2>
        <p class="text-sm text-slate-500 mt-1">Belge kalemlerini ve cari hesap bilgilerini eksiksiz doldurun.</p>
    </div>
    <a href="@Model.GetRedirectPage(Model.Type)" class="text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 font-medium flex items-center">
        <span class="material-icons-round text-sm mr-1">arrow_back</span>
        Listeye Dön
    </a>
</div>

<form method="post" id="InvoiceForm" data-nx-submit-lock data-currency="@Model.Invoice.Currency" data-default-vat-rate="@Model.DefaultVatRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-use-product-pricing="@Model.UsesSalesPricing.ToString().ToLowerInvariant()" data-use-purchase-costing="@Model.UsesPurchaseCosting.ToString().ToLowerInvariant()" data-product-lookup-url="@Url.Page("/Invoices/Create", "ProductLookup", new { type = Model.Type })" data-business-partner-lookup-url="@Url.Page("/Invoices/Create", "BusinessPartnerLookup", new { type = Model.Type })">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsDocumentNumberAutoGenerated" />
    <input type="hidden" asp-for="Invoice.Type" />
    
    <div asp-validation-summary="All" class="text-red-600 mb-4 bg-red-50 p-4 rounded-lg"></div>

    <!-- Başlık Bilgileri -->
    <div class="card p-5 sm:p-6 mb-6">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-4 border-b border-slate-100 dark:border-slate-700 pb-2">Genel Bilgiler</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-5">
            <div>
                <label asp-for="Invoice.DocNumber" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Belge No</label>
                <input asp-for="Invoice.DocNumber" id="InvoiceDocNumber" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" />
                <p class="mt-1 text-xs text-slate-500">Boş bırakılırsa numara otomatik oluşturulur.</p>
            </div>
            <div>
                <label asp-for="Invoice.Currency" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">@L["Pricing:DocumentCurrency"]</label>
                @if (Model.IsTryOnlySalesDocument)
                {
                    <input asp-for="Invoice.Currency" type="hidden" value="TRY" />
                    <select id="InvoiceCurrency" class="w-full bg-slate-100 border border-slate-200 text-slate-700 rounded-lg block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" disabled><option selected>TRY</option></select>
                    <p id="InvoiceRateInfo" class="mt-1 text-xs text-slate-500">Türkiye satış işlemleri yalnızca TL olarak yürütülür.</p>
                }
                else
                {
                    <select asp-for="Invoice.Currency" id="InvoiceCurrency" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white"><option>TRY</option><option>USD</option><option>EUR</option></select>
                    <p id="InvoiceRateInfo" class="mt-1 text-xs text-slate-500">İşlem kuru kaydedilirken güvenilir kur kaynağından alınır.</p>
                }
            </div>
            @if (!Model.IsTryOnlySalesDocument)
            {
                <div>
                    <label asp-for="Invoice.ExchangeRate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Belge günü kuru (1 döviz = TL)</label>
                    <input asp-for="Invoice.ExchangeRate" id="InvoiceExchangeRate" type="number" min="0.01" step="0.01" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" />
                    <p class="mt-1 text-xs text-slate-500">Bu kur belgeyle birlikte saklanır ve sonradan değişmez.</p>
                </div>
            }
            <div>
                <label asp-for="Invoice.BusinessPartnerId" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                    @Model.GetPartnerLabel()
                </label>
                <div class="invoice-partner-picker">
                    <input id="BusinessPartnerSearch" type="search" class="invoice-lookup-search" placeholder="@Model.GetPartnerLabel() ara / vergi no" autocomplete="off" aria-label="@Model.GetPartnerLabel() ara" />
                    <select asp-for="Invoice.BusinessPartnerId" asp-items="Model.BusinessPartners" id="InvoiceBusinessPartner" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required></select>
                    <span id="BusinessPartnerSearchStatus" class="invoice-lookup-status" aria-live="polite">Aramak için yazın; sonuçlar gerektiğinde yüklenir.</span>
                </div>
            </div>
            <div>
                <label asp-for="Invoice.Date" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Tarih</label>
                <input asp-for="Invoice.Date" type="date" value='@Model.Invoice.Date.ToString("yyyy-MM-dd")' class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required />
            </div>
            <div>
                <label asp-for="Invoice.DueDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Vade / Geçerlilik Tarihi</label>
                <input asp-for="Invoice.DueDate" type="date" value='@Model.Invoice.DueDate?.ToString("yyyy-MM-dd")' class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" />
            </div>
        </div>
    </div>

    @if (Model.UsesSalesPricing)
    {
        <div class="mb-6 rounded-lg border border-indigo-200 bg-indigo-50/70 p-4 text-sm text-indigo-950 dark:border-indigo-900/60 dark:bg-indigo-950/30 dark:text-indigo-100">
            <div class="flex gap-2"><span class="material-icons-round text-base">lock</span><div><strong>@L["Pricing:SalesSnapshot"]</strong><p class="mt-1 text-xs text-indigo-800 dark:text-indigo-200">Ürün seçildiğinde aktif satış fiyatı otomatik gelir. Fiyatı değiştirirseniz bu belgeye özel olarak korunur.</p></div></div>
        </div>
    }
    @if (Model.UsesPurchaseCosting)
    {
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50/70 p-4 text-sm text-emerald-950 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-100">
            <div class="flex gap-2"><span class="material-icons-round text-base">receipt_long</span><div><strong>@L["Pricing:PurchaseDraft"]</strong><p class="mt-1 text-xs text-emerald-800 dark:text-emerald-200">Taslak kayıt maliyeti değiştirmez. Ürün maliyeti yalnızca alış faturası onaylandığında güncellenir.</p></div></div>
            <details id="PurchaseCostImpact" class="invoice-cost-impact mt-3 hidden rounded border border-emerald-200 bg-white/70 text-xs text-slate-700 dark:border-emerald-900/60 dark:bg-slate-900/30 dark:text-slate-200">
                <summary>Fiyat etkisini göster</summary>
                <div class="purchase-impact-body"></div>
            </details>
        </div>
    }

    <!-- Kalemler -->
    <div class="card p-0 mb-6 overflow-hidden">
        <div class="p-5 sm:p-6 border-b border-slate-100 dark:border-slate-700 flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center">
            <h3 class="text-lg font-bold text-slate-800 dark:text-white">Fatura Kalemleri</h3>
            <button type="button" id="AddRowBtn" class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center">
                <span class="material-icons-round text-sm mr-1">add</span>
                Yeni Satır Ekle
            </button>
        </div>
        <div class="invoice-lines-scroll overflow-x-auto">
            <table class="invoice-lines-table text-left" id="ItemsTable">
                <colgroup>
                    <col class="invoice-col-product" />
                    <col class="invoice-col-quantity" />
                    <col class="invoice-col-price" />
                    <col class="invoice-col-discount" />
                    <col class="invoice-col-vat" />
                    <col class="invoice-col-total" />
                    <col class="invoice-col-actions" />
                </colgroup>
                <thead class="bg-slate-50 dark:bg-slate-800/50">
                    <tr>
                        <th>Ürün</th>
                        <th>Miktar</th>
                        <th>Birim fiyat</th>
                        <th>@(Model.UsesPurchaseCosting ? "Alış iskontoları %" : "Satış iskontoları %")</th>
                        <th>KDV %</th>
                        <th class="text-right">Satır toplamı</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="ItemsTbody">
                    @for (var index = 0; index < Model.Invoice.Items.Count; index++)
                    {
                        var item = Model.Invoice.Items[index];
                        var selectedProductLabel = Model.SelectedProductLabels.GetValueOrDefault(item.ProductId, $"Ürün ({item.ProductId})");
                        <tr class="item-row border-b border-slate-100 dark:border-slate-700">
                            <td>
                                <input type="hidden" name="Invoice.Items.Index" value="@index" />
                                <div class="invoice-product-picker">
                                <input type="search" class="product-search" placeholder="Ürün ara / barkod okut" autocomplete="off" aria-label="Ürün ara" />
                                <div class="invoice-product-select-row"><select name="Invoice.Items[@index].ProductId" class="product-select invoice-product-select w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required>
                                    <option value="">Ürün seçiniz...</option>
                                    @if (item.ProductId != Guid.Empty)
                                    {
                                        <option value="@item.ProductId" selected>@selectedProductLabel</option>
                                    }
                                </select><button type="button" class="quick-product-create" title="Listede olmayan ürünü kaydet">Yeni ürün</button></div><span class="product-search-status invoice-lookup-status" aria-live="polite">Aramak için yazın veya barkod okutun.</span></div>
                            </td>
                            <td><input type="number" name="Invoice.Items[@index].Quantity" class="calc-input quantity-input invoice-number-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="@(item.Quantity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" min="0.01" step="0.01" required /></td>
                            <td>
                                <input type="hidden" name="Invoice.Items[@index].IsUnitPriceOverridden" class="price-overridden-input" value="@item.IsUnitPriceOverridden.ToString().ToLowerInvariant()" />
                                <input type="number" name="Invoice.Items[@index].UnitPrice" class="calc-input price-input invoice-price-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="@item.UnitPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" required />
                                <p class="price-source mt-1 text-xs text-slate-500">Bu satırın kaydedilmiş fiyatı.</p>
                                <div class="invoice-line-pricing-summary" aria-live="polite"></div>
                            </td>
                            <td>
                                @if (Model.UsesPurchaseCosting)
                                {
                                    <input type="hidden" name="Invoice.Items[@index].DiscountRate" value="@item.DiscountRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                    <div class="invoice-purchase-discounts">
                                        <input type="number" name="Invoice.Items[@index].PurchaseDiscount1" class="calc-input purchase-discount-input invoice-rate-input" value="@item.PurchaseDiscount1.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" aria-label="Alış iskontosu 1" />
                                        <input type="number" name="Invoice.Items[@index].PurchaseDiscount2" class="calc-input purchase-discount-input invoice-rate-input" value="@item.PurchaseDiscount2.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" aria-label="Alış iskontosu 2" />
                                        <input type="number" name="Invoice.Items[@index].PurchaseDiscount3" class="calc-input purchase-discount-input invoice-rate-input" value="@item.PurchaseDiscount3.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" aria-label="Alış iskontosu 3" />
                                        <input type="number" name="Invoice.Items[@index].PurchaseDiscount4" class="calc-input purchase-discount-input invoice-rate-input" value="@item.PurchaseDiscount4.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" aria-label="Alış iskontosu 4" />
                                    </div>
                                }
                                else
                                {
                                    <input type="hidden" name="Invoice.Items[@index].DiscountRate" value="@item.DiscountRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                    <div class="invoice-purchase-discounts">
                                        <input type="number" name="Invoice.Items[@index].SalesDiscount1" class="calc-input sales-discount-input invoice-rate-input" value="@item.SalesDiscount1.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" aria-label="Satış iskontosu 1" />
                                        <input type="number" name="Invoice.Items[@index].SalesDiscount2" class="calc-input sales-discount-input invoice-rate-input" value="@item.SalesDiscount2.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" aria-label="Satış iskontosu 2" />
                                        <input type="number" name="Invoice.Items[@index].SalesDiscount3" class="calc-input sales-discount-input invoice-rate-input" value="@item.SalesDiscount3.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" aria-label="Satış iskontosu 3" />
                                        <input type="number" name="Invoice.Items[@index].SalesDiscount4" class="calc-input sales-discount-input invoice-rate-input" value="@item.SalesDiscount4.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" aria-label="Satış iskontosu 4" />
                                    </div>
                                }
                            </td>
                            <td><input type="number" name="Invoice.Items[@index].VatRate" class="calc-input vat-input invoice-rate-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="@item.VatRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" /></td>
                            <td class="text-right font-semibold text-slate-800 dark:text-white row-total">0.00</td>
                            <td class="text-center"><button type="button" class="remove-row-btn text-slate-400 hover:text-red-500 transition-colors"><span class="material-icons-round text-lg">delete</span></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Alt Toplamlar ve Kaydet -->
    <div class="flex justify-end mb-12">
        <div class="invoice-summary w-full card p-5 sm:p-6">
            <div class="space-y-3 text-sm">
                <div class="flex justify-between text-slate-600 dark:text-slate-400">
                    <span>Ara Toplam:</span>
                    <span id="SumSubtotal" class="font-medium">0.00 TRY</span>
                </div>
                <div class="flex justify-between text-slate-600 dark:text-slate-400">
                    <span>İskonto Toplamı:</span>
                    <span id="SumDiscount" class="font-medium text-red-500">0.00 TRY</span>
                </div>
                <div class="flex justify-between text-slate-600 dark:text-slate-400">
                    <span>KDV Toplamı:</span>
                    <span id="SumVat" class="font-medium">0.00 TRY</span>
                </div>
                <div class="flex justify-between text-lg font-bold text-slate-900 dark:text-white pt-3 border-t border-slate-200 dark:border-slate-700">
                    <span>Genel Toplam:</span>
                    <span id="SumGrandTotal">0.00 TRY</span>
                </div>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
                @if (Model.UsesPurchaseCosting)
                {
                    <p class="mb-3 text-xs text-slate-500">Kaydetmek ürün maliyetini değiştirmez. Güncelleme, belge onaylandığında uygulanır.</p>
                }
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-4 rounded-lg transition-colors shadow-md shadow-indigo-500/30 flex justify-center items-center">
                    <span class="material-icons-round mr-2 text-sm">save</span>
                    @(Model.IsEditing ? "Değişiklikleri Kaydet" : "Belgeyi Kaydet")
                </button>
            </div>
        </div>
    </div>
</form>
</div>

<template id="ItemRowTemplate">
    <tr class="item-row border-b border-slate-100 dark:border-slate-700">
        <td>
            <input type="hidden" name="Invoice.Items.Index" value="{id}" />
            <div class="invoice-product-picker"><input type="search" class="product-search" placeholder="Ürün ara / barkod okut" autocomplete="off" aria-label="Ürün ara" /><div class="invoice-product-select-row"><select name="Invoice.Items[{id}].ProductId" class="product-select invoice-product-select w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required>
                <option value="">Ürün seçiniz...</option>
            </select><button type="button" class="quick-product-create" title="Listede olmayan ürünü kaydet">Yeni ürün</button></div><span class="product-search-status invoice-lookup-status" aria-live="polite">Aramak için yazın veya barkod okutun.</span></div>
        </td>
        <td>
            <input type="number" name="Invoice.Items[{id}].Quantity" class="calc-input quantity-input invoice-number-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="1" min="0.01" step="0.01" required />
        </td>
        <td>
            <input type="hidden" name="Invoice.Items[{id}].IsUnitPriceOverridden" class="price-overridden-input" value="false" />
            <input type="number" name="Invoice.Items[{id}].UnitPrice" class="calc-input price-input invoice-price-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="0" min="0" step="0.01" required />
            <p class="price-source mt-1 text-xs text-slate-500"></p>
            <div class="invoice-line-pricing-summary" aria-live="polite"></div>
        </td>
        <td>
            @if (Model.UsesPurchaseCosting)
            {
                <input type="hidden" name="Invoice.Items[{id}].DiscountRate" value="0" />
                <div class="invoice-purchase-discounts">
                    <input type="number" name="Invoice.Items[{id}].PurchaseDiscount1" class="calc-input purchase-discount-input invoice-rate-input" value="0" min="0" max="100" step="0.01" aria-label="Alış iskontosu 1" />
                    <input type="number" name="Invoice.Items[{id}].PurchaseDiscount2" class="calc-input purchase-discount-input invoice-rate-input" value="0" min="0" max="100" step="0.01" aria-label="Alış iskontosu 2" />
                    <input type="number" name="Invoice.Items[{id}].PurchaseDiscount3" class="calc-input purchase-discount-input invoice-rate-input" value="0" min="0" max="100" step="0.01" aria-label="Alış iskontosu 3" />
                    <input type="number" name="Invoice.Items[{id}].PurchaseDiscount4" class="calc-input purchase-discount-input invoice-rate-input" value="0" min="0" max="100" step="0.01" aria-label="Alış iskontosu 4" />
                </div>
            }
            else
            {
                <input type="hidden" name="Invoice.Items[{id}].DiscountRate" value="0" />
                <div class="invoice-purchase-discounts">
                    <input type="number" name="Invoice.Items[{id}].SalesDiscount1" class="calc-input sales-discount-input invoice-rate-input" value="0" min="0" max="100" step="0.01" aria-label="Satış iskontosu 1" />
                    <input type="number" name="Invoice.Items[{id}].SalesDiscount2" class="calc-input sales-discount-input invoice-rate-input" value="0" min="0" max="100" step="0.01" aria-label="Satış iskontosu 2" />
                    <input type="number" name="Invoice.Items[{id}].SalesDiscount3" class="calc-input sales-discount-input invoice-rate-input" value="0" min="0" max="100" step="0.01" aria-label="Satış iskontosu 3" />
                    <input type="number" name="Invoice.Items[{id}].SalesDiscount4" class="calc-input sales-discount-input invoice-rate-input" value="0" min="0" max="100" step="0.01" aria-label="Satış iskontosu 4" />
                </div>
            }
        </td>
        <td>
            <input type="number" name="Invoice.Items[{id}].VatRate" class="calc-input vat-input invoice-rate-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="@Model.DefaultVatRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" />
        </td>
        <td class="text-right font-semibold text-slate-800 dark:text-white row-total">
            0.00
        </td>
        <td class="text-center">
            <button type="button" class="remove-row-btn text-slate-400 hover:text-red-500 transition-colors">
                <span class="material-icons-round text-lg">delete</span>
            </button>
        </td>
    </tr>
</template>

<style>
    .invoice-page-shell { max-width: 1560px; margin: 0 auto; }
    .invoice-lines-table { min-width: 980px; width: 100%; table-layout: fixed; border-collapse: collapse; }
    .invoice-lines-table .invoice-col-product { width: 33%; }
    .invoice-lines-table .invoice-col-quantity { width: 10%; }
    .invoice-lines-table .invoice-col-price { width: 18%; }
    .invoice-lines-table .invoice-col-discount { width: 10%; }
    .invoice-lines-table .invoice-col-vat { width: 9%; }
    .invoice-lines-table .invoice-col-total { width: 15%; }
    .invoice-lines-table .invoice-col-actions { width: 5%; }
