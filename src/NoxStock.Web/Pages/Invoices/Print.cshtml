@page
@model NoxStock.Web.Pages.Invoices.PrintModel
@{
    Layout = null;
    ViewData["Title"] = $"Fatura {Model.Document.DocNumber}";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #f1f5f9; color: #172033; font-family: Arial, sans-serif; }
        .toolbar { max-width: 210mm; margin: 16px auto; display: flex; justify-content: flex-end; }
        .toolbar button { border: 0; border-radius: 4px; background: #4f46e5; color: #fff; cursor: pointer; font-size: 14px; padding: 10px 16px; }
        .invoice { width: 210mm; min-height: 297mm; margin: 0 auto 20px; padding: 18mm; background: #fff; }
        .header, .party-grid, .summary { display: flex; justify-content: space-between; gap: 24px; }
        .brand { max-width: 58%; } .company-name { color: #312e81; font-size: 27px; font-weight: 700; letter-spacing: 0; margin: 0 0 8px; }
        .muted { color: #64748b; font-size: 13px; line-height: 1.55; white-space: pre-line; }
        .document-title { color: #312e81; font-size: 24px; font-weight: 700; letter-spacing: 0; text-align: right; }
        .document-meta { margin-top: 12px; font-size: 13px; line-height: 1.8; text-align: right; }
        .status { display: inline-block; margin-top: 6px; padding: 3px 8px; border: 1px solid #cbd5e1; border-radius: 3px; color: #475569; font-size: 11px; text-transform: uppercase; }
        .rule { border: 0; border-top: 2px solid #312e81; margin: 26px 0; }
        .party { width: 48%; } .section-label { color: #475569; font-size: 11px; font-weight: 700; letter-spacing: 0; margin-bottom: 8px; text-transform: uppercase; }
        .party-name { font-size: 17px; font-weight: 700; margin-bottom: 5px; }
        table { border-collapse: collapse; margin-top: 28px; width: 100%; } th { background: #312e81; color: #fff; font-size: 11px; font-weight: 700; padding: 10px 8px; text-align: left; text-transform: uppercase; } td { border-bottom: 1px solid #e2e8f0; font-size: 13px; padding: 11px 8px; vertical-align: top; } .right { text-align: right; }
        .summary { justify-content: flex-end; margin-top: 22px; } .summary-table { width: 260px; } .summary-row { display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; font-size: 13px; padding: 7px 0; } .summary-row.total { border-bottom: 0; color: #312e81; font-size: 17px; font-weight: 700; padding-top: 12px; }
        .notes { border-top: 1px solid #e2e8f0; color: #475569; font-size: 12px; line-height: 1.55; margin-top: 44px; padding-top: 14px; }
        @@media print { body { background: #fff; } .toolbar { display: none; } .invoice { box-shadow: none; margin: 0; } @@page { margin: 0; size: A4; } }
    </style>
</head>
<body>
    <div class="toolbar"><button type="button" onclick="window.print()">Yazdır</button></div>
    <main class="invoice">
        <header class="header">
            <section class="brand">
                <h1 class="company-name">@(string.IsNullOrWhiteSpace(Model.Company.CompanyName) ? "NoxStock" : Model.Company.CompanyName)</h1>
                <div class="muted">@Model.Company.Address
@Model.Company.Phone
@Model.Company.Email
Vergi Dairesi: @Model.Company.TaxOffice | Vergi No: @Model.Company.TaxNumber</div>
            </section>
            <section>
                <div class="document-title">@Model.GetDocumentTitle()</div>
                <div class="document-meta"><strong>No:</strong> @Model.Document.DocNumber<br /><strong>Tarih:</strong> @Model.Document.Date.ToString("dd.MM.yyyy")<br />@if (Model.Document.DueDate.HasValue) { <text><strong>Vade:</strong> @Model.Document.DueDate.Value.ToString("dd.MM.yyyy")<br /></text> }<span class="status">@Model.GetStatus()</span></div>
            </section>
        </header>
        <hr class="rule" />
        <section class="party-grid">
            <div class="party">
                <div class="section-label">@(Model.Document.Type == NoxStock.Documents.DocumentType.SaleInvoice ? "Müşteri" : "Tedarikçi")</div>
                <div class="party-name">@Model.Document.BusinessPartnerName</div>
            </div>
            <div class="party">
                <div class="section-label">Para Birimi</div>
                <div class="party-name">@Model.Document.Currency</div>
                @if (Model.Document.Currency != "TRY") { <div class="muted">Belge kuru: @Model.Document.ExchangeRate.ToString("N4") TRY</div> }
            </div>
        </section>
        <table>
            <thead><tr><th>Ürün / Hizmet</th><th class="right">Miktar</th><th class="right">Birim Fiyat</th><th class="right">İskonto</th><th class="right">KDV</th><th class="right">Toplam</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Document.Items)
            {
                <tr><td>@item.ProductName</td><td class="right">@item.Quantity.ToString("N4")</td><td class="right">@item.UnitPrice.ToString("N4") @Model.Document.Currency</td><td class="right">%@item.DiscountRate.ToString("N2")</td><td class="right">%@item.VatRate.ToString("N2")</td><td class="right">@item.Total.ToString("N4") @Model.Document.Currency</td></tr>
            }
            </tbody>
        </table>
        <section class="summary"><div class="summary-table"><div class="summary-row"><span>Ara Toplam</span><strong>@Model.Document.Subtotal.ToString("N4") @Model.Document.Currency</strong></div><div class="summary-row"><span>İskonto</span><strong>@Model.Document.DiscountTotal.ToString("N4") @Model.Document.Currency</strong></div><div class="summary-row"><span>KDV</span><strong>@Model.Document.VatTotal.ToString("N4") @Model.Document.Currency</strong></div><div class="summary-row total"><span>Genel Toplam</span><span>@Model.Document.GrandTotal.ToString("N4") @Model.Document.Currency</span></div></div></section>
        @if (!string.IsNullOrWhiteSpace(Model.Document.Description)) { <section class="notes"><strong>Açıklama</strong><br />@Model.Document.Description</section> }
    </main>
</body>
</html>
