@page
@using Microsoft.AspNetCore.Mvc.Localization
@model NoxStock.Web.Pages.Invoices.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Faturalar";
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-white sm:text-3xl">Faturalar</h2>
        <p class="text-sm text-slate-500 mt-1">Alış ve satış faturalarını yönetin.</p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row">
        <a href="~/Invoices/Create?type=SaleInvoice" id="NewSaleInvoiceButton" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-md font-medium transition-colors flex items-center justify-center">
            <span class="material-icons-round mr-2 text-sm">add</span>
            Yeni Satış Faturası
        </a>
        <a href="~/Invoices/Create?type=PurchaseInvoice" id="NewPurchaseInvoiceButton" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-md font-medium transition-colors flex items-center justify-center">
            <span class="material-icons-round mr-2 text-sm">add</span>
            Yeni Alış Faturası
        </a>
    </div>
</div>

<div class="card overflow-hidden">
    <div class="p-6">
        <div class="mb-5 flex items-center gap-3">
            <label for="DueFilter" class="text-sm font-medium text-slate-700 dark:text-slate-300">Vade Durumu</label>
            <select id="DueFilter" class="w-56 bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white">
                <option value="0">Tüm Faturalar</option>
                <option value="1">Gecikmiş Faturalar</option>
                <option value="2">7 Gün İçinde Vadesi Dolacak</option>
            </select>
        </div>
        <div class="overflow-x-auto">
            <table id="InvoicesTable" class="table w-full text-left whitespace-nowrap">
                <thead>
                    <tr>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">İşlemler</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Fatura No</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Cari Hesap</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Tip</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Tarih</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Vade</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Genel Toplam</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Kalan</th>
                        <th class="py-4 px-4 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Durum</th>
                    </tr>
                </thead>
                <tbody class="text-sm">
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <abp-script src="/Pages/Invoices/Index.js" />
}
