@page
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Licensing
@using NoxStock.Localization
@model NoxStock.Web.Pages.License.UnavailableModel
@inject IHtmlLocalizer<NoxStockResource> L
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["License:AccessBlockedTitle"].Value;

    var statusText = Model.License.Status switch
    {
        LicenseStatus.Suspended => L["License:Status:Suspended"].Value,
        LicenseStatus.Expired => L["License:Status:Expired"].Value,
        LicenseStatus.Cancelled => L["License:Status:Cancelled"].Value,
        _ => L["License:Missing"].Value
    };

    var detail = Model.License.Status switch
    {
        LicenseStatus.Suspended => L["License:AccessBlockedSuspended"].Value,
        LicenseStatus.Expired => L["License:AccessBlockedExpired"].Value,
        LicenseStatus.Cancelled => L["License:AccessBlockedCancelled"].Value,
        null => L["License:AccessBlockedMissing"].Value,
        _ => L["License:AccessBlockedGeneric"].Value
    };
}

<section class="rounded-xl border border-amber-200 bg-amber-50 p-6 shadow-sm dark:border-amber-900/70 dark:bg-amber-950/30" aria-labelledby="license-unavailable-title">
    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/60 dark:text-amber-300">
        <span class="material-icons-round" aria-hidden="true">workspace_premium</span>
    </div>
    <p class="mt-5 text-xs font-semibold uppercase tracking-[0.12em] text-amber-700 dark:text-amber-300">@L["License:AccessBlockedEyebrow"]</p>
    <h1 id="license-unavailable-title" class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">@L["License:AccessBlockedTitle"]</h1>
    <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">@L["License:AccessBlockedDescription"]</p>

    <div class="mt-5 rounded-lg border border-amber-200 bg-white/80 px-4 py-3 text-sm dark:border-amber-900/70 dark:bg-slate-900/40">
        <div class="font-semibold text-slate-800 dark:text-slate-100">@L["License:AccessBlockedStatus"]: @statusText</div>
        <p class="mt-1 text-slate-600 dark:text-slate-300">@detail</p>
    </div>

    <form method="post" asp-page="/Account/Logout" class="mt-6">
        <button type="submit" class="inline-flex items-center gap-2 rounded-md bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">
            <span class="material-icons-round text-base" aria-hidden="true">logout</span>
            @L["License:SignOut"]
        </button>
    </form>
</section>
