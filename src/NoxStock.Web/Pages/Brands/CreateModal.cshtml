@page
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IHtmlLocalizer<NoxStockResource> L
@model NoxStock.Web.Pages.Brands.CreateModalModel
@{
    Layout = null;
}

<form asp-page="/Brands/CreateModal">
    <abp-modal>
        <abp-modal-header title="@L["NewBrand"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Brand.Name" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
