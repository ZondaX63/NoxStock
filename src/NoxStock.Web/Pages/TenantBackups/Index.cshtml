@page
@model NoxStock.Web.Pages.TenantBackups.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Tenant Yedekleri";
}

<div class="container py-4">
    @if (Model.IsHost)
    {
        <div class="mb-4">
            <h1 class="h3">Yeni Tenant Clone</h1>
            <p class="text-muted">Süresi geçmemiş bir yedekten yeni kimliklerle boş bir test tenantı oluşturun.</p>
            <div class="alert alert-warning mb-0">Bu işlem yeni test tenantı oluşturur; mevcut tenantın üzerine yazmaz.</div>
        </div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }
        @if (Model.CloneOperation is not null)
        {
            <div class="alert alert-info" id="cloneOperation" data-operation-id="@Model.CloneOperation.Id">
                <strong>Clone işlemi kaydedildi.</strong>
                <span id="cloneOperationStatus">Durum: @Model.CloneOperation.Status; işlenen kayıt: @Model.CloneOperation.ProcessedRecordCount.</span>
                <span id="cloneOperationFailure" class="text-danger">@Model.CloneOperation.FailureCode</span>
            </div>
        }
        @if (Model.Preview is not null)
        {
            <div class="card mb-3"><div class="card-body">
                <h2 class="h6">Uyumluluk: @(Model.Preview.IsCompatible ? "Uygun" : "Uygun değil")</h2>
                <div>Kaynak: @Model.Preview.SourceTenantName (<code>@Model.Preview.SourceTenantId</code>)</div>
                <div>Hedef: @Model.Preview.TargetTenantName (<code>@Model.Preview.TargetTenantCode</code>)</div>
                <ul class="mb-0 mt-2">
                    @foreach (var module in Model.Preview.ModuleRecordCounts) { <li>@module.Key: @module.Value kayıt</li> }
                    @foreach (var warning in Model.Preview.Warnings) { <li class="text-warning">@warning</li> }
                </ul>
            </div></div>
        }
        <form method="post" id="cloneForm" class="card">
            <div class="card-body row g-3">
                <input asp-for="OperationKey" type="hidden" />
                <div class="col-12"><label class="form-label">Kaynak tenant yedeği</label><select asp-for="SourceBackupId" class="form-select"><option value="">Yedek seçin</option>@foreach (var backup in Model.CloneSources) { <option value="@backup.Id">@backup.TenantId — @backup.RequestedAtUtc.ToLocalTime():g (@((backup.FileSize ?? 0) / 1024) KB)</option> }</select><div class="form-text">Yalnız başarılı ve süresi geçmemiş yedekler gösterilir. Paket boyutu üst sınırı 512 MB’tır.</div></div>
                <div class="col-md-6"><label class="form-label">Paket parolası</label><input asp-for="RestorePassword" type="password" autocomplete="off" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Tenant kodu</label><input asp-for="TargetTenantCode" class="form-control" placeholder="demo-clone" /></div>
                <div class="col-md-6"><label class="form-label">İşletme adı</label><input asp-for="TargetTenantName" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Yeni yönetici e-postası</label><input asp-for="AdminEmailAddress" type="email" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Yeni yönetici parolası</label><input asp-for="AdminPassword" type="password" autocomplete="new-password" class="form-control" /></div>
                <div class="col-12 d-flex gap-2"><button asp-page-handler="Clone" class="btn btn-primary">Yeni tenant oluştur</button><span id="cloneStatus" class="text-muted align-self-center"></span></div>
            </div>
        </form>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div><h1 class="h3">Tenant Yedekleri</h1><p class="text-muted mb-0">Ticari verilerinizi şifreli .noxbackup paketi olarak hazırlayın.</p></div>
            <button class="btn btn-primary" id="createBackup">Yeni yedek oluştur</button>
        </div>
        <div class="alert alert-info">Paket parolası sunucuda saklanmaz. Parolayı güvenli ve ayrı bir yerde saklayın.</div>
        <div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
            <thead><tr><th>Talep zamanı</th><th>Durum</th><th>Boyut</th><th>Son kullanım</th><th></th></tr></thead>
            <tbody id="backupRows"><tr><td colspan="5" class="text-muted">Yükleniyor…</td></tr></tbody>
        </table></div></div>
    }
</div>

@section Scripts { <abp-script src="/Pages/TenantBackups/Index.js" /> }
