@page
@model NoxStock.Web.Pages.LicenseManagement.IndexModel
@using NoxStock.Licensing
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Localization
@inject IHtmlLocalizer<NoxStockResource> L
@{
    ViewData["Title"] = L["License:Title"].Value;

    string StatusText(LicenseStatus status) => status switch
    {
        LicenseStatus.Trial => L["License:Status:Trial"].Value,
        LicenseStatus.Active => L["License:Status:Active"].Value,
        LicenseStatus.GracePeriod => L["License:Status:GracePeriod"].Value,
        LicenseStatus.PastDue => L["License:Status:PastDue"].Value,
        LicenseStatus.Suspended => L["License:Status:Suspended"].Value,
        LicenseStatus.Expired => L["License:Status:Expired"].Value,
        LicenseStatus.Cancelled => L["License:Status:Cancelled"].Value,
        _ => status.ToString()
    };

    string StatusClass(LicenseStatus status) => status switch
    {
        LicenseStatus.Trial or LicenseStatus.Active => "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300",
        LicenseStatus.GracePeriod or LicenseStatus.PastDue => "bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300",
        _ => "bg-rose-100 text-rose-700 dark:bg-rose-500/15 dark:text-rose-300"
    };
}

<div class="space-y-6">
    @if (TempData["LicenseMessage"] is string message)
    {
        <div class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200" role="status">@message</div>
    }

    <div>
        <p class="text-xs font-semibold uppercase text-indigo-600">@L["License:Eyebrow"]</p>
        <h1 class="mt-1 text-2xl font-semibold text-slate-900 dark:text-white">@L["License:Title"]</h1>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">@L["License:Description"]</p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
            <div class="text-xs font-semibold uppercase text-slate-500">@L["License:TotalCompanies"]</div>
            <div class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">@Model.Rows.Count</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
            <div class="text-xs font-semibold uppercase text-slate-500">@L["License:WriteAccessOpen"]</div>
            <div class="mt-2 text-2xl font-bold text-emerald-600">@Model.Rows.Count(row => row.License?.EffectiveStatus is LicenseStatus.Trial or LicenseStatus.Active or LicenseStatus.GracePeriod)</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
            <div class="text-xs font-semibold uppercase text-slate-500">@L["License:RestrictedOrMissing"]</div>
            <div class="mt-2 text-2xl font-bold text-amber-600">@Model.Rows.Count(row => row.License is null || row.License.EffectiveStatus is LicenseStatus.PastDue or LicenseStatus.Suspended or LicenseStatus.Expired or LicenseStatus.Cancelled)</div>
        </div>
    </div>

    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[1040px] text-left text-sm">
                <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-400">
                    <tr>
                        <th class="px-5 py-4">@L["License:Company"]</th>
                        <th class="px-5 py-4">@L["License:PlanAndStatus"]</th>
                        <th class="px-5 py-4">@L["License:Validity"]</th>
                        <th class="px-5 py-4">@L["License:Limits"]</th>
                        <th class="px-5 py-4 text-right">@L["License:Management"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="align-top hover:bg-slate-50 dark:hover:bg-slate-700/30">
                            <td class="px-5 py-4">
                                <div class="font-semibold text-slate-900 dark:text-white">@row.TenantName</div>
                                <div class="mt-1 font-mono text-xs text-slate-500">@row.TenantId</div>
                            </td>
                            @if (row.License is null)
                            {
                                <td class="px-5 py-4 text-amber-700">@L["License:Missing"]</td>
                                <td class="px-5 py-4 text-slate-500">-</td>
                                <td class="px-5 py-4 text-slate-500">-</td>
                                <td class="px-5 py-4">
                                    <form method="post" asp-page-handler="Assign" class="flex items-center justify-end gap-2">
                                        <input type="hidden" name="tenantId" value="@row.TenantId" />
                                        <select name="planId" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900">
                                            @foreach (var plan in Model.Plans)
                                            {
                                                <option value="@plan.Id">@plan.Name</option>
                                            }
                                        </select>
                                        <button class="rounded-md bg-indigo-600 px-3 py-2 font-semibold text-white hover:bg-indigo-700" type="submit">@L["License:StartPilot"]</button>
                                    </form>
                                </td>
                            }
                            else
                            {
                                var license = row.License;
                                <td class="px-5 py-4">
                                    <div class="font-semibold text-slate-900 dark:text-white">@license.PlanName</div>
                                    <span class="mt-2 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @StatusClass(license.EffectiveStatus)">@StatusText(license.EffectiveStatus)</span>
                                    <div class="mt-2 text-xs text-slate-500">@license.LicenseReference</div>
                                </td>
                                <td class="px-5 py-4">
                                    <div class="font-medium text-slate-800 dark:text-slate-200">@license.ExpiresAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                    @if (license.GracePeriodEndsAtUtc.HasValue)
                                    {
                                        <div class="mt-1 text-xs text-slate-500">@L["License:GraceUntil"]: @license.GracePeriodEndsAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                    }
                                </td>
                                <td class="px-5 py-4 text-xs text-slate-600 dark:text-slate-300">
                                    @foreach (var limit in license.Limits.OrderBy(item => item.LimitName))
                                    {
                                        <div><span class="font-medium">@limit.LimitName:</span> @(limit.LimitValue?.ToString() ?? L["License:Unlimited"].Value)</div>
                                    }
                                </td>
                                <td class="px-5 py-4">
                                    <div class="flex flex-wrap items-center justify-end gap-2">
                                        <a asp-page="/LicenseManagement/Index" asp-route-licenseId="@license.Id" data-license-action="details" class="rounded-md border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700">@L["License:History"]</a>
                                        <form method="post" asp-page-handler="ChangePlan" class="flex items-center gap-1" aria-label="@L["License:ChangePlan"]">
                                            <input type="hidden" name="licenseId" value="@license.Id" />
                                            <select name="planId" class="rounded-md border border-slate-300 bg-white px-2 py-2 text-xs dark:border-slate-600 dark:bg-slate-900">
                                                @foreach (var plan in Model.Plans)
                                                {
                                                    <option value="@plan.Id" selected="@(plan.Id == license.LicensePlanId)">@plan.Name</option>
                                                }
                                            </select>
                                            <button data-license-action="change-plan" class="rounded-md border border-slate-300 px-2 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200" type="submit" title="@L["License:Apply"]">@L["License:Apply"]</button>
                                        </form>
                                        <form method="post" asp-page-handler="Extend">
                                            <input type="hidden" name="licenseId" value="@license.Id" />
                                            <input type="hidden" name="days" value="30" />
                                            <button data-license-action="extend" class="rounded-md border border-indigo-300 px-3 py-2 text-xs font-semibold text-indigo-700 hover:bg-indigo-50 dark:text-indigo-300" type="submit">@L["License:Extend30Days"]</button>
                                        </form>
                                        @if (license.EffectiveStatus == LicenseStatus.Suspended)
                                        {
                                            <form method="post" asp-page-handler="Reactivate">
                                                <input type="hidden" name="licenseId" value="@license.Id" />
                                                <button data-license-action="reactivate" class="rounded-md bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700" type="submit">@L["License:Reactivate"]</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="SetPastDue">
                                                <input type="hidden" name="licenseId" value="@license.Id" />
                                                <button class="rounded-md border border-amber-300 px-3 py-2 text-xs font-semibold text-amber-700 hover:bg-amber-50" type="submit">@L["License:ReadOnly"]</button>
                                            </form>
                                            <form method="post" asp-page-handler="Expire">
                                                <input type="hidden" name="licenseId" value="@license.Id" />
                                                <button data-license-action="expire" class="rounded-md border border-rose-300 px-3 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-50" type="submit">@L["License:ExpireNow"]</button>
                                            </form>
                                            <form method="post" asp-page-handler="Suspend" class="flex">
                                                <input type="hidden" name="licenseId" value="@license.Id" />
                                                <input type="hidden" name="reason" value="Platform yöneticisi tarafından askıya alındı." />
                                                <button data-license-action="suspend" class="rounded-md border border-rose-300 px-3 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-50" type="submit">@L["License:Suspend"]</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.SelectedLicense?.PlanCode == "CUSTOM")
    {
        var customLicense = Model.SelectedLicense;
        bool HasFeature(string name) => customLicense.Features.Any(item => item.FeatureName == name && item.IsEnabled);
        int? LimitValue(string name) => customLicense.Limits.FirstOrDefault(item => item.LimitName == name)?.LimitValue;

        <section class="rounded-lg border border-indigo-200 bg-white p-5 shadow-sm dark:border-indigo-800 dark:bg-slate-800" aria-labelledby="custom-license-heading">
            <div class="flex flex-col gap-1 border-b border-slate-200 pb-4 dark:border-slate-700">
                <p class="text-xs font-semibold uppercase text-indigo-600">@L["License:CustomEditor:Eyebrow"]</p>
                <h2 id="custom-license-heading" class="text-lg font-semibold text-slate-900 dark:text-white">@customLicense.TenantName</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">@L["License:CustomEditor:Description"]</p>
            </div>

            <form method="post" asp-page-handler="UpdateEntitlements" class="mt-5 space-y-6">
                <input type="hidden" name="licenseId" value="@customLicense.Id" />
                <fieldset>
                    <legend class="text-sm font-semibold text-slate-900 dark:text-white">@L["License:Features"]</legend>
                    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
                        @foreach (var feature in new[]
                        {
                            (Name: LicenseFeatureNames.Pos, Field: "pos", Label: L["License:Feature:Pos"].Value),
                            (Name: LicenseFeatureNames.MultiCurrency, Field: "multiCurrency", Label: L["License:Feature:MultiCurrency"].Value),
                            (Name: LicenseFeatureNames.DynamicPricing, Field: "dynamicPricing", Label: L["License:Feature:DynamicPricing"].Value),
                            (Name: LicenseFeatureNames.AdvancedReports, Field: "advancedReports", Label: L["License:Feature:AdvancedReports"].Value),
                            (Name: LicenseFeatureNames.Export, Field: "export", Label: L["License:Feature:Export"].Value)
                        })
                        {
                            <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-200 px-3 py-3 text-sm font-medium text-slate-700 dark:border-slate-700 dark:text-slate-200">
                                <input type="checkbox" name="@feature.Field" value="true" checked="@HasFeature(feature.Name)" class="h-4 w-4 rounded border-slate-300 text-indigo-600" />
                                @feature.Label
                            </label>
                        }
                    </div>
                </fieldset>

                <fieldset>
                    <legend class="text-sm font-semibold text-slate-900 dark:text-white">@L["License:Limits"]</legend>
                    <p class="mt-1 text-xs text-slate-500">@L["License:CustomEditor:UnlimitedHint"]</p>
                    <div class="mt-3 grid gap-4 md:grid-cols-3">
                        <label class="text-sm font-medium text-slate-700 dark:text-slate-200">
                            @L["License:Limit:Users"]
                            <input type="number" min="1" name="maxUsers" value="@LimitValue(LicenseLimitNames.MaxUsers)" class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" />
                        </label>
                        <label class="text-sm font-medium text-slate-700 dark:text-slate-200">
                            @L["License:Limit:Products"]
                            <input type="number" min="1" name="maxProducts" value="@LimitValue(LicenseLimitNames.MaxProducts)" class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" />
                        </label>
                        <label class="text-sm font-medium text-slate-700 dark:text-slate-200">
                            @L["License:Limit:Branches"]
                            <input type="number" min="1" name="maxBranches" value="@LimitValue(LicenseLimitNames.MaxBranches)" class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" />
                        </label>
                    </div>
                </fieldset>

                <div class="flex justify-end">
                    <button type="submit" data-license-action="save-entitlements" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">@L["License:SaveEntitlements"]</button>
                </div>
            </form>
        </section>
    }

    @if (Model.SelectedLicenseId.HasValue)
    {
        <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@L["License:AuditTitle"]</h2>
            <div class="mt-4 space-y-3">
                @if (Model.AuditLogs.Count == 0)
                {
                    <p class="text-sm text-slate-500">@L["License:NoAudit"]</p>
                }
                @foreach (var audit in Model.AuditLogs)
                {
                    <div class="flex flex-col gap-1 border-b border-slate-100 pb-3 text-sm last:border-0 dark:border-slate-700 md:flex-row md:items-center md:justify-between">
                        <div>
                            <span class="font-semibold text-slate-900 dark:text-white">@audit.Action</span>
                            @if (!string.IsNullOrWhiteSpace(audit.Details))
                            {
                                <span class="ml-2 text-slate-500">@audit.Details</span>
                            }
                        </div>
                        <time class="text-xs text-slate-500">@audit.CreationTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                    </div>
                }
            </div>
        </div>
    }
</div>
