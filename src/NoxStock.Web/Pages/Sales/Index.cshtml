@page
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Localization
@model NoxStock.Web.Pages.Sales.IndexModel
@inject IHtmlLocalizer<NoxStockResource> L
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Perakende Satış (POS)";
}

<div class="mb-6 flex items-start justify-between gap-4 sm:items-center">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-white sm:text-3xl">Perakende Satış</h2>
        <p class="text-sm text-slate-500 mt-1">Barkod okutun, sepeti oluşturun ve tahsilatı tamamlayın.</p>
    </div>
    <button id="RefreshPosButton" type="button" class="w-10 h-10 inline-flex items-center justify-center border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg" title="Ürünleri yenile">
        <span class="material-icons-round">refresh</span>
    </button>
</div>

<div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_390px] gap-6">
    <section class="min-w-0">
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-slate-100 dark:border-slate-700 space-y-4">
                <label for="PosSearch" class="sr-only">Ürün, barkod veya OEM ara</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400"><span class="material-icons-round">qr_code_scanner</span></span>
                    <input id="PosSearch" type="search" autocomplete="off" placeholder="Barkod okutun veya ürün, stok kodu, OEM arayın" class="w-full pl-12 pr-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-900 text-slate-800 dark:text-white" />
                </div>
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="block text-sm font-medium text-slate-700 dark:text-slate-300">Satış para birimi: Türk lirası (TRY)</p>
                        <p class="mt-1 text-xs text-slate-500">Dövize çıpalı ürünler güncel TCMB kuru üzerinden otomatik TL fiyatlanır.</p>
                    </div>
                    <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300">TRY satış</span>
                </div>
            </div>
            <div id="PosProductGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 p-5 min-h-96" aria-busy="true" aria-label="Ürünler yükleniyor">
                @for (var skeletonIndex = 0; skeletonIndex < 6; skeletonIndex++)
                {
                    <div class="pos-loading-card" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                }
            </div>
        </div>

        <div class="card overflow-hidden mt-6">
            <div class="p-5 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-800 dark:text-white">Son POS Satışları</h3>
                    <p class="text-sm text-slate-500 mt-1">İptal işlemleri ters kayıtla uygulanır.</p>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left whitespace-nowrap">
                    <thead class="bg-slate-50/60 dark:bg-slate-800/60">
                        <tr>
                            <th class="py-3 px-5 text-xs font-semibold uppercase text-slate-500">Fiş</th>
                            <th class="py-3 px-5 text-xs font-semibold uppercase text-slate-500">Tarih</th>
                            <th class="py-3 px-5 text-xs font-semibold uppercase text-slate-500">Müşteri</th>
                            <th class="py-3 px-5 text-xs font-semibold uppercase text-slate-500">Ödeme</th>
                            <th class="py-3 px-5 text-xs font-semibold uppercase text-slate-500 text-right">Toplam</th>
                            <th class="py-3 px-5 text-xs font-semibold uppercase text-slate-500 text-right">İşlem</th>
                        </tr>
                    </thead>
                    <tbody id="RecentPosSalesBody" class="divide-y divide-slate-100 dark:divide-slate-700 text-sm" aria-busy="true">
                        @for (var skeletonIndex = 0; skeletonIndex < 3; skeletonIndex++)
                        {
                            <tr class="pos-loading-row" aria-hidden="true"><td colspan="6"><span></span><span></span><span></span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <aside class="card overflow-hidden h-fit xl:sticky xl:top-5">
        <div class="p-5 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
            <div><h3 class="text-lg font-bold text-slate-800 dark:text-white flex items-center"><span class="material-icons-round mr-2 text-indigo-600">shopping_cart</span>Sepet</h3><p class="mt-1 text-xs text-slate-500">@L["Pricing:CartPriceLocked"]</p></div>
            <div class="flex items-center gap-2"><button id="RefreshPosPricesButton" type="button" class="inline-flex h-8 items-center gap-1 rounded-md border border-indigo-200 px-2 text-xs font-semibold text-indigo-700 hover:bg-indigo-50 dark:border-indigo-900 dark:text-indigo-300" title="Manuel değiştirilmemiş fiyatları güncel kurla yenile"><span class="material-icons-round text-sm">sync</span>@L["Pricing:RefreshPrices"]</button><span id="PosCartCount" class="text-xs font-bold bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 px-2.5 py-1 rounded-full">0 ürün</span></div>
        </div>
        <div id="PosCartItems" class="max-h-96 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-700"></div>
        <div class="p-5 bg-slate-50/70 dark:bg-slate-900/30 border-t border-slate-100 dark:border-slate-700">
            <div class="flex justify-between text-sm mb-2"><span class="text-slate-500">Ara toplam</span><span id="PosSubtotal" class="font-semibold text-slate-800 dark:text-white">0,00 TL</span></div>
            <div class="flex justify-between items-center py-4 border-y border-dashed border-slate-200 dark:border-slate-700"><span class="font-bold text-slate-800 dark:text-white">Genel toplam</span><span id="PosTotal" class="text-2xl font-black text-indigo-600 dark:text-indigo-400">0,00 TL</span></div>

            <div class="mt-5">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Ödeme Yöntemi</label>
                <div class="grid grid-cols-3 gap-2" id="PosPaymentMethods">
                    <button type="button" data-method="1" class="pos-payment-method border border-indigo-600 bg-indigo-600 text-white p-2 rounded-lg text-sm font-semibold">Nakit</button>
                    <button type="button" data-method="2" class="pos-payment-method border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 p-2 rounded-lg text-sm font-semibold">Banka</button>
                    <button type="button" data-method="3" class="pos-payment-method border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 p-2 rounded-lg text-sm font-semibold">Cari</button>
                </div>
            </div>

            <div id="PosAccountField" class="mt-4">
                <label for="PosAccount" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Kasa / Banka</label>
                <select id="PosAccount" disabled class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg p-2.5 text-slate-800 dark:text-white"><option>Seçenekler yükleniyor…</option></select>
            </div>
            <div class="mt-4">
                <label for="PosCustomer" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Müşteri <span id="PosCustomerRequired" class="hidden text-rose-600">(zorunlu)</span></label>
                <select id="PosCustomer" disabled class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg p-2.5 text-slate-800 dark:text-white"><option>Seçenekler yükleniyor…</option></select>
            </div>
            <div class="mt-4">
                <label for="PosNote" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Not</label>
                <input id="PosNote" type="text" maxlength="500" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg p-2.5 text-slate-800 dark:text-white" placeholder="Opsiyonel satış notu" />
            </div>

            <div class="grid grid-cols-2 gap-3 mt-5">
                <button id="ClearPosCartButton" type="button" class="border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 py-3 rounded-lg font-semibold flex items-center justify-center"><span class="material-icons-round mr-2 text-base">delete_sweep</span>Temizle</button>
                <button id="CompletePosSaleButton" type="button" class="bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-400 text-white py-3 rounded-lg font-semibold flex items-center justify-center"><span class="material-icons-round mr-2 text-base">payments</span>Satışı Tamamla</button>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <abp-script src="/Pages/Sales/Index.js" />
}
