@page
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IHtmlLocalizer<NoxStockResource> L
@model NoxStock.Web.Pages.Products.CreateModalModel
@{
    Layout = null;
}

<form id="ProductCreateDialogForm" method="post" asp-page="/Products/CreateModal" class="product-create-dialog-form">
    <abp-modal size="ExtraLarge" centered="true" scrollable="true" modal-class="product-create-modal">
        <abp-modal-header title="Yeni ürün kartı"></abp-modal-header>
        <abp-modal-body>
            <div class="product-dialog-layout">
                <div class="product-dialog-main">
                    <div class="product-dialog-tabs" role="tablist">
                        <button type="button" class="product-dialog-tab is-active" data-dialog-tab="identity">Temel bilgiler</button>
                        <button type="button" class="product-dialog-tab" data-dialog-tab="pricing">Fiyat &amp; maliyet</button>
                        <button type="button" class="product-dialog-tab" data-dialog-tab="stock">Stok &amp; raf</button>
                    </div>
                    <section class="product-dialog-section" data-dialog-section="identity">
                        <div class="product-dialog-section-title"><span class="material-icons-round">badge</span><div><h4>Ürün kimliği</h4><p>Arama, barkod ve OEM referansları için temel kart bilgileri.</p></div></div>
                        <div class="row g-3">
                            <div class="col-md-8"><label asp-for="Product.Name" class="form-label">Ürün adı *</label><input asp-for="Product.Name" class="form-control" autocomplete="off" /></div>
                            <div class="col-md-4"><label asp-for="Product.Sku" class="form-label">Stok kodu *</label><div class="product-code-input"><input asp-for="Product.Sku" class="form-control" autocomplete="off" /><button type="button" data-dialog-generate-sku title="Otomatik kod üret"><span class="material-icons-round">auto_awesome</span></button></div></div>
                            <div class="col-md-4"><label asp-for="Product.Barcode" class="form-label">Barkod</label><input asp-for="Product.Barcode" class="form-control" inputmode="numeric" autocomplete="off" /></div>
                            <div class="col-md-4"><label asp-for="Product.BrandId" class="form-label">Marka</label><div class="input-group"><select asp-for="Product.BrandId" asp-items="Model.Brands" class="form-select"></select><button type="button" class="btn btn-outline-primary" data-quick-lookup-create="brand" title="Yeni marka ekle"><span class="material-icons-round">add</span></button></div><div class="quick-lookup-panel" data-quick-lookup-panel="brand" hidden><input type="text" class="form-control form-control-sm" data-quick-lookup-name placeholder="Marka adı" maxlength="150" /><div><button type="button" class="btn btn-primary btn-sm" data-quick-lookup-save>Kaydet</button><button type="button" class="btn btn-link btn-sm" data-quick-lookup-cancel>Vazgeç</button></div></div><small class="pricing-field-hint">Listede yoksa buradan ekleyin.</small></div>
                            <div class="col-md-4"><label asp-for="Product.CategoryId" class="form-label">Kategori</label><div class="input-group"><select asp-for="Product.CategoryId" asp-items="Model.Categories" class="form-select"></select><button type="button" class="btn btn-outline-primary" data-quick-lookup-create="category" title="Yeni kategori ekle"><span class="material-icons-round">add</span></button></div><div class="quick-lookup-panel" data-quick-lookup-panel="category" hidden><input type="text" class="form-control form-control-sm" data-quick-lookup-name placeholder="Kategori adı" maxlength="150" /><div><button type="button" class="btn btn-primary btn-sm" data-quick-lookup-save>Kaydet</button><button type="button" class="btn btn-link btn-sm" data-quick-lookup-cancel>Vazgeç</button></div></div><small class="pricing-field-hint">Listede yoksa buradan ekleyin.</small></div>
                            <div class="col-12"><label asp-for="Product.OemCodes" class="form-label">OEM / çapraz referans kodları</label><input asp-for="Product.OemCodes" class="form-control" placeholder="34116775277, 34 11 6 775 277" /><small class="form-text">Virgülle ayırın; arama aynı ürünü alternatif kodlardan bulur.</small></div>
                            <div class="col-12"><label asp-for="Product.Description" class="form-label">Kısa tanım</label><textarea asp-for="Product.Description" class="form-control" rows="2"></textarea></div>
                        </div>
                    </section>
                    <section class="product-dialog-section" data-dialog-section="pricing" hidden>
                        <div class="product-dialog-section-title"><span class="material-icons-round">payments</span><div><h4>Fiyat &amp; maliyet</h4><p>Alıştan müşteri bitiş fiyatına kadar tüm hesaplama zinciri.</p></div></div>
                        <div class="pricing-block">
                            <div class="pricing-block-title"><b>1</b><span><strong>Alış faturası &amp; döviz</strong><small>Liste fiyatı ve işlem günündeki kur.</small></span></div>
                            <div class="row g-3">
                                <div class="col-md-6"><label asp-for="Product.PurchaseListPrice" class="form-label">Liste alış fiyatı</label><input asp-for="Product.PurchaseListPrice" class="form-control" type="number" step="0.0001" min="0" /></div>
                                <div class="col-md-6"><label asp-for="Product.PurchaseCurrency" class="form-label">Referans / alış para birimi</label><select asp-for="Product.PurchaseCurrency" class="form-select"><option>TRY</option><option>USD</option><option>EUR</option></select></div>
                                <div class="col-md-8"><label asp-for="Product.ExchangeRateAtPurchase" class="form-label">İşlem kuru (1 döviz = TL)</label><div class="pricing-rate-input"><input asp-for="Product.ExchangeRateAtPurchase" class="form-control" type="number" step="0.000001" min="0.000001" data-purchase-rate readonly /><button type="button" data-rate-refresh><span class="material-icons-round">refresh</span>TCMB</button></div></div>
                                <div class="col-md-4 d-flex align-items-end"><label class="pricing-override-toggle"><input type="checkbox" data-rate-override /><span>Kuru elle değiştir</span></label></div>
                            </div>
                        </div>
                        <div class="pricing-block">
                            <div class="pricing-block-title"><b>2</b><span><strong>Kademeli alış iskontoları</strong><small>Oranlar sırayla uygulanır.</small></span></div>
                            <div class="pricing-four-grid"><label>İsk. 1 %<input asp-for="Product.PurchaseDiscount1" class="form-control" type="number" min="0" max="100" step="0.01" /></label><label>İsk. 2 %<input asp-for="Product.PurchaseDiscount2" class="form-control" type="number" min="0" max="100" step="0.01" /></label><label>İsk. 3 %<input asp-for="Product.PurchaseDiscount3" class="form-control" type="number" min="0" max="100" step="0.01" /></label><label>İsk. 4 %<input asp-for="Product.PurchaseDiscount4" class="form-control" type="number" min="0" max="100" step="0.01" /></label></div>
                            <div class="pricing-inline-result">Net alış: <strong data-dialog-value="net-purchase-currency">0,0000 TRY</strong></div>
                        </div>
                        <div class="pricing-block">
                            <div class="pricing-block-title"><b>3</b><span><strong>Satış stratejisi</strong><small>Mod seçimi hangi alanın fiyatı yönettiğini belirler.</small></span></div>
                            <div class="row g-3">
                                <div class="col-md-6"><label asp-for="Product.PricingMode" class="form-label">Satış fiyatı modu</label><select asp-for="Product.PricingMode" class="form-select"><option value="0">Sabit fiyat</option><option value="1">Dövize çıpalı dinamik</option></select></div>
                                <div class="col-md-6" data-manual-sale-field><label asp-for="Product.SalePrice" class="form-label" data-sale-price-label>Manuel satış fiyatı (KDV'siz, TL)</label><div class="input-group"><input asp-for="Product.SalePrice" class="form-control" type="number" step="0.0001" min="0" /><button type="button" class="btn btn-outline-primary" data-apply-recommended-price title="Net maliyet ve hedef marjı satış fiyatına uygula"><span aria-hidden="true">⚡</span><span class="d-none d-lg-inline">Önerilen</span></button><span class="input-group-text">TRY</span></div><small class="pricing-field-hint" data-sale-price-hint></small></div>
                                <div class="col-md-6" data-markup-field><label asp-for="Product.ProfitMarkupPercent" class="form-label" data-markup-label>Hedef kâr ekleme oranı (%)</label><input asp-for="Product.ProfitMarkupPercent" class="form-control" type="number" min="0" step="0.01" /><small class="pricing-field-hint" data-markup-hint></small></div>
                                <div class="col-md-6"><label asp-for="Product.VatRate" class="form-label">KDV oranı</label><select asp-for="Product.VatRate" class="form-select"><option value="0">%0</option><option value="1">%1</option><option value="10">%10</option><option value="20">%20</option></select></div>
                            </div>
                            <div class="pricing-mode-explainer" data-pricing-mode-explainer></div>
                        </div>
                        <div class="pricing-block">
                            <div class="pricing-block-title"><b>4</b><span><strong>Varsayılan satış iskontoları</strong><small>Müşteri satışında sırayla uygulanır.</small></span></div>
                            <div class="pricing-four-grid"><label>Satış İsk. 1 %<input asp-for="Product.SalesDiscount1" class="form-control" type="number" min="0" max="100" step="0.01" /></label><label>Satış İsk. 2 %<input asp-for="Product.SalesDiscount2" class="form-control" type="number" min="0" max="100" step="0.01" /></label><label>Satış İsk. 3 %<input asp-for="Product.SalesDiscount3" class="form-control" type="number" min="0" max="100" step="0.01" /></label><label>Satış İsk. 4 %<input asp-for="Product.SalesDiscount4" class="form-control" type="number" min="0" max="100" step="0.01" /></label></div>
                        </div>
                        <input asp-for="Product.PurchasePrice" type="hidden" />
                        <div class="product-dialog-note"><span class="material-icons-round">verified_user</span>Ürün kartı fiyat politikasını saklar; onaylı alış faturası maliyet geçmişinin otoritesidir.</div>
                    </section>
                    <section class="product-dialog-section" data-dialog-section="stock" hidden>
                        <div class="product-dialog-section-title"><span class="material-icons-round">shelves</span><div><h4>Stok &amp; raf</h4><p>Depo görevlisinin ürünü hızlı bulması için operasyonel bilgiler.</p></div></div>
                        <div class="row g-3">
                            <div class="col-md-4"><label asp-for="Product.Quantity" class="form-label">Açılış stoğu</label><input asp-for="Product.Quantity" class="form-control" type="number" step="any" min="0" /></div>
                            <div class="col-md-4"><label asp-for="Product.Unit" class="form-label">Birim</label><select asp-for="Product.Unit" class="form-select"><option>Adet</option><option>Kg</option><option>Lt</option><option>Mt</option><option>Koli</option></select></div>
                            <div class="col-md-4"><label asp-for="Product.CriticalStockLevel" class="form-label">Kritik stok seviyesi</label><input asp-for="Product.CriticalStockLevel" class="form-control" type="number" step="any" min="0" /></div>
                            <div class="col-md-8"><label asp-for="Product.ShelfLocation" class="form-label">Depo / raf konumu</label><input asp-for="Product.ShelfLocation" class="form-control" placeholder="A-12-3" /></div>
                            <div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="Product.TrackStock" class="form-check-input" /><label asp-for="Product.TrackStock" class="form-check-label">Stok takibi aktif</label></div></div>
                        </div>
                    </section>
                </div>
                <aside class="product-dialog-hero product-finance-hero" aria-live="polite">
                    <div class="product-finance-hero-head"><div><span class="products-eyebrow">CANLI FİNANSAL ÖZET</span><h4>Hesaplama akışı</h4></div><span class="product-live-badge"><i></i>Canlı</span></div>
                    <div class="product-finance-main"><span>Net TL maliyet</span><strong data-dialog-value="cost">₺0,00</strong><small data-dialog-value="meta">4'lü alış iskontosu ve kur dahil</small></div>
                    <dl class="product-finance-breakdown"><div><dt>Liste satış fiyatı (KDV'siz)</dt><dd data-dialog-value="list">₺0,00</dd></div><div><dt>Satış iskontosu</dt><dd data-dialog-value="sales-discount">-₺0,00</dd></div><div><dt>İskontolu satış</dt><dd data-dialog-value="net-sale">₺0,00</dd></div><div><dt data-dialog-value="vat-label">KDV (%20)</dt><dd data-dialog-value="vat-amount">₺0,00</dd></div></dl>
                    <div class="product-final-price"><span>Müşteri bitiş fiyatı</span><strong data-dialog-value="final">₺0,00</strong><small>KDV dahil ödenecek tutar</small></div>
                    <div class="product-finance-profit"><span>Tahmini brüt kâr</span><strong data-dialog-value="profit">₺0,00</strong><small data-dialog-value="realized-markup">Gerçekleşen markup: %0,00</small><small data-dialog-value="margin">Brüt kâr marjı: %0,00</small></div>
                    <div class="product-finance-integrity"><span class="material-icons-round">lock</span><p>POS ve faturada fiyat/kursnapshotı belge satırında korunur.</p></div>
                </aside>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
