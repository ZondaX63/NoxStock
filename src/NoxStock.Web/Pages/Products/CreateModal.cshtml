@page
@using Microsoft.AspNetCore.Mvc.Localization
@using NoxStock.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IHtmlLocalizer<NoxStockResource> L
@model NoxStock.Web.Pages.Products.CreateModalModel
@{
    Layout = null;
}

<form asp-page="/Products/CreateModal">
    <abp-modal size="Large">
        <abp-modal-header title="@L["NewProduct"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Product.Name" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="Product.Sku" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_6">
                    <abp-select asp-for="Product.BrandId" asp-items="Model.Brands" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-select asp-for="Product.CategoryId" asp-items="Model.Categories" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_4">
                    <abp-input asp-for="Product.SalePrice" />
                </abp-column>
                <abp-column size-md="_4">
                    <abp-input asp-for="Product.PurchasePrice" />
                </abp-column>
                <abp-column size-md="_4">
                    <abp-input asp-for="Product.Quantity" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Product.ProfitMarkupPercent" />
                </abp-column>
                <abp-column size-md="_6" class="d-flex align-items-end">
                    <abp-input asp-for="Product.UseCurrentExchangeRateForSale" />
                </abp-column>
            </abp-row>
            <p class="text-muted small mb-0">Yabancı para ile alınan ürünlerde satış fiyatı, güncel kur ve kâr marjı ile satış anında hesaplanır.</p>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
