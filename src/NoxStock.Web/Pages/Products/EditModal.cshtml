@page
@using System.Globalization
@using NoxStock.Products
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NoxStock.Web.Pages.Products.EditModalModel
@{
    Layout = null;
}

<form id="ProductEditForm"
      method="post"
      asp-page="/Products/EditModal"
      class="product-create-dialog-form product-edit-dialog-form"
      data-approved-reference-cost="@(Model.PricingQuote?.LastPurchaseCostCurrencyAmount?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
      data-approved-try-cost="@(Model.PricingQuote?.LastPurchaseCostTryAmount?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)">
    <abp-modal size="ExtraLarge" centered="true" scrollable="true" modal-class="product-create-modal">
        <abp-modal-header title="Ürün kartını düzenle"></abp-modal-header>
        <abp-modal-body>
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="alert alert-danger product-save-errors" role="alert"></div>
            <div class="product-dialog-layout">
                <div class="product-dialog-main">
                    <div class="product-dialog-tabs" role="tablist">
                        <button type="button" class="product-dialog-tab is-active" data-dialog-tab="identity">Temel bilgiler</button>
                        <button type="button" class="product-dialog-tab" data-dialog-tab="pricing">Fiyat &amp; maliyet</button>
                        <button type="button" class="product-dialog-tab" data-dialog-tab="stock">Stok &amp; raf</button>
                    </div>
                    <section class="product-dialog-section" data-dialog-section="identity">
                        <div class="product-dialog-section-title"><span class="material-icons-round">edit_note</span><div><h4>Ürün kimliği</h4><p>Yalnızca ürün adı zorunludur; eksik bilgileri dilediğiniz zaman tamamlayabilirsiniz.</p></div></div>
                        <div class="row g-3">
                            <div class="col-md-8"><label asp-for="Product.Name" class="form-label">Ürün adı <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Product.Name" class="form-control" required aria-required="true" /><span asp-validation-for="Product.Name" class="text-danger small d-block mt-1"></span></div>
                            <div class="col-md-4"><label asp-for="Product.Sku" class="form-label">Stok kodu <small>(boşsa otomatik)</small></label><div class="product-code-input"><input asp-for="Product.Sku" class="form-control" /><button type="button" data-dialog-generate-sku title="Yeni kod üret"><span class="material-icons-round">auto_awesome</span></button></div></div>
                            <div class="col-md-4"><label asp-for="Product.Barcode" class="form-label">Barkod</label><input asp-for="Product.Barcode" class="form-control" /></div>
                            <div class="col-md-4"><label asp-for="Product.BrandId" class="form-label">Marka</label><div class="input-group"><select asp-for="Product.BrandId" asp-items="Model.Brands" class="form-select"></select><button type="button" class="btn btn-outline-primary" data-quick-lookup-create="brand" title="Yeni marka ekle"><span class="material-icons-round">add</span></button></div><div class="quick-lookup-panel" data-quick-lookup-panel="brand" hidden><input type="text" class="form-control form-control-sm" data-quick-lookup-name placeholder="Marka adı" maxlength="150" /><div><button type="button" class="btn btn-primary btn-sm" data-quick-lookup-save>Kaydet</button><button type="button" class="btn btn-link btn-sm" data-quick-lookup-cancel>Vazgeç</button></div></div><small class="pricing-field-hint">Listede yoksa buradan ekleyin.</small></div>
                            <div class="col-md-4"><label asp-for="Product.CategoryId" class="form-label">Kategori</label><div class="input-group"><select asp-for="Product.CategoryId" asp-items="Model.Categories" class="form-select"></select><button type="button" class="btn btn-outline-primary" data-quick-lookup-create="category" title="Yeni kategori ekle"><span class="material-icons-round">add</span></button></div><div class="quick-lookup-panel" data-quick-lookup-panel="category" hidden><input type="text" class="form-control form-control-sm" data-quick-lookup-name placeholder="Kategori adı" maxlength="150" /><div><button type="button" class="btn btn-primary btn-sm" data-quick-lookup-save>Kaydet</button><button type="button" class="btn btn-link btn-sm" data-quick-lookup-cancel>Vazgeç</button></div></div><small class="pricing-field-hint">Listede yoksa buradan ekleyin.</small></div>
                            <div class="col-12"><label asp-for="Product.OemCodes" class="form-label">OEM / çapraz referans kodları</label><input asp-for="Product.OemCodes" class="form-control" placeholder="1234, 5678" /></div>
                            <div class="col-12"><label asp-for="Product.Description" class="form-label">Kısa tanım</label><textarea asp-for="Product.Description" class="form-control" rows="2"></textarea></div>
                        </div>
                    </section>
                    <section class="product-dialog-section" data-dialog-section="pricing" hidden>
                        <div class="product-dialog-section-title"><span class="material-icons-round">payments</span><div><h4>Fiyat &amp; maliyet politikası</h4><p>Alıştan müşteri bitiş fiyatına kadar tüm hesaplama zinciri.</p></div></div>
                        <div class="pricing-block">
                            <div class="pricing-block-title"><b>1</b><span><strong>Alış faturası &amp; döviz</strong><small>Liste fiyatı ve işlem günündeki kur.</small></span></div>
                            <div class="row g-3">
                                <div class="col-md-6"><label asp-for="Product.PurchaseListPrice" class="form-label">Liste alış fiyatı</label><input asp-for="Product.PurchaseListPrice" class="form-control" type="number" step="1" min="0" /></div>
                                <div class="col-md-6"><label asp-for="Product.PurchaseCurrency" class="form-label">Referans / alış para birimi</label><select asp-for="Product.PurchaseCurrency" class="form-select"><option>EUR</option><option>USD</option><option>TRY</option></select><small class="pricing-field-hint">Değiştirildiğinde geçmiş maliyet korunur; aktif maliyet belge günü kuru ile yeni referans para birimine çevrilir.</small></div>
                                <div class="col-md-8"><label asp-for="Product.ExchangeRateAtPurchase" class="form-label">İşlem kuru (1 döviz = TL) <span class="text-danger" aria-hidden="true">*</span></label><div class="pricing-rate-input"><input asp-for="Product.ExchangeRateAtPurchase" class="form-control" type="number" step="0.000001" min="0.000001" data-purchase-rate readonly required aria-required="true" /><button type="button" data-rate-refresh><span class="material-icons-round">refresh</span>TCMB</button></div><span asp-validation-for="Product.ExchangeRateAtPurchase" class="text-danger small d-block mt-1"></span></div>
                                <div class="col-md-4 d-flex align-items-end"><label class="pricing-override-toggle"><input type="checkbox" data-rate-override /><span>Kuru elle değiştir</span></label></div>
                            </div>
                        </div>
                        <div class="pricing-block">
                            <div class="pricing-block-title"><b>2</b><span><strong>Kademeli alış iskontoları</strong><small>Oranlar sırayla uygulanır.</small></span></div>
                            <div class="pricing-four-grid"><label>İsk. 1 %<input asp-for="Product.PurchaseDiscount1" class="form-control" type="number" min="0" max="100" step="1" /></label><label>İsk. 2 %<input asp-for="Product.PurchaseDiscount2" class="form-control" type="number" min="0" max="100" step="1" /></label><label>İsk. 3 %<input asp-for="Product.PurchaseDiscount3" class="form-control" type="number" min="0" max="100" step="1" /></label><label>İsk. 4 %<input asp-for="Product.PurchaseDiscount4" class="form-control" type="number" min="0" max="100" step="1" /></label></div>
                            <div class="pricing-inline-result">Net alış: <strong data-dialog-value="net-purchase-currency">0,0000 TRY</strong></div>
                        </div>
                        <div class="pricing-block">
                            <div class="pricing-block-title"><b>3</b><span><strong>Satış stratejisi</strong><small>Mod seçimi hangi alanın fiyatı yönettiğini belirler.</small></span></div>
                            <div class="row g-3">
                                <div class="col-md-6"><label asp-for="Product.PricingMode" class="form-label">Satış fiyatı modu</label><select asp-for="Product.PricingMode" class="form-select"><option value="0">Sabit fiyat</option><option value="1">Dövize çıpalı dinamik</option></select></div>
                                <div class="col-md-6" data-manual-sale-field><label asp-for="Product.SalePrice" class="form-label" data-sale-price-label>Manuel satış fiyatı (KDV'siz, TL)</label><div class="input-group"><input asp-for="Product.SalePrice" class="form-control" type="number" step="1" min="0" /><span class="input-group-text">TRY</span></div><small class="pricing-field-hint" data-sale-price-hint></small></div>
                                <div class="col-md-6" data-markup-field><label asp-for="Product.ProfitMarkupPercent" class="form-label" data-markup-label>Hedef kâr ekleme oranı (%)</label><input asp-for="Product.ProfitMarkupPercent" class="form-control" type="number" min="0" step="1" /><small class="pricing-field-hint" data-markup-hint></small></div>
                                <div class="col-md-6"><label asp-for="Product.VatRate" class="form-label">KDV oranı</label><select asp-for="Product.VatRate" class="form-select"><option value="0">%0</option><option value="1">%1</option><option value="10">%10</option><option value="20">%20</option></select></div>
                            </div>
                            <div class="pricing-mode-explainer" data-pricing-mode-explainer></div>
                        </div>
                        <input asp-for="Product.PurchasePrice" type="hidden" />
                        <div class="product-dialog-note"><span class="material-icons-round">verified_user</span>Geçmiş alış maliyeti ve belge kuru değişmez; referans para birimi yalnızca aktif fiyatlama profilini yeniden ifade eder.</div>
                    </section>
                    <section class="product-dialog-section" data-dialog-section="stock" hidden>
                        <div class="product-dialog-section-title"><span class="material-icons-round">shelves</span><div><h4>Stok &amp; raf</h4><p>Operasyonel stok ve konum bilgisini güncelleyin.</p></div></div>
                        <div class="row g-3">
                            <div class="col-md-4"><label asp-for="Product.Quantity" class="form-label">Stok miktarı</label><input asp-for="Product.Quantity" class="form-control" type="number" step="1" /></div>
                            <div class="col-md-4"><label asp-for="Product.Unit" class="form-label">Birim</label><select asp-for="Product.Unit" class="form-select"><option>Adet</option><option>Kg</option><option>Lt</option><option>Mt</option><option>Koli</option></select></div>
                            <div class="col-md-4"><label asp-for="Product.CriticalStockLevel" class="form-label">Kritik stok seviyesi</label><input asp-for="Product.CriticalStockLevel" class="form-control" type="number" step="1" min="0" /></div>
                            <div class="col-md-8"><label asp-for="Product.ShelfLocation" class="form-label">Depo / raf konumu</label><input asp-for="Product.ShelfLocation" class="form-control" placeholder="A-12-3" /></div>
                            <div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="Product.TrackStock" class="form-check-input" /><label asp-for="Product.TrackStock" class="form-check-label">Stok takibi aktif</label></div></div>
                        </div>
                    </section>
                </div>
                <aside class="product-dialog-hero product-finance-hero" aria-live="polite">
                    <div class="product-finance-hero-head"><div><span class="products-eyebrow">CANLI FİNANSAL ÖZET</span><h4>Hesaplama akışı</h4></div><span class="product-live-badge"><i></i>Canlı</span></div>
                    <div class="product-finance-main"><span>Net TL maliyet</span><strong data-dialog-value="cost">₺0,00</strong><small data-dialog-value="meta">4'lü alış iskontosu ve kur dahil</small></div>
                    <dl class="product-finance-breakdown"><div><dt>Liste satış fiyatı (KDV'siz)</dt><dd data-dialog-value="list">₺0,00</dd></div><div><dt>KDV hariç satış</dt><dd data-dialog-value="net-sale">₺0,00</dd></div><div><dt data-dialog-value="vat-label">KDV (%20)</dt><dd data-dialog-value="vat-amount">₺0,00</dd></div></dl>
                    <div class="product-final-price"><span>Müşteri bitiş fiyatı</span><strong data-dialog-value="final">₺0,00</strong><small>KDV dahil ödenecek tutar</small></div>
                    <div class="product-finance-profit"><span>Tahmini brüt kâr</span><strong data-dialog-value="profit">₺0,00</strong><small data-dialog-value="realized-markup">Gerçekleşen markup: %0,00</small><small data-dialog-value="margin">Brüt kâr marjı: %0,00</small></div>
                    <div class="product-finance-integrity"><span class="material-icons-round">verified_user</span><p>Müşteri iskontoları fatura/POS satırında uygulanır; satış fiyatı ve kur belge satırına snapshot olarak kaydedilir.</p></div>
                </aside>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
