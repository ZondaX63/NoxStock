@page
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NoxStock.Web.Pages.Products.EditModalModel
@{
    Layout = null;
}

<form asp-page="/Products/EditModal">
    <abp-modal size="ExtraLarge">
        <abp-modal-header title="Ürün Düzenle"></abp-modal-header>
        <abp-modal-body>
            <input asp-for="Id" type="hidden" />
            <div class="row g-4">
                @* Kart Bilgileri *@
                <div class="col-12">
                    <h6 class="fw-semibold text-muted mb-3 border-bottom pb-2">Kart Bilgileri</h6>
                </div>
                <div class="col-md-4">
                    <label asp-for="Product.Name" class="form-label">Ürün Adı <span class="text-danger">*</span></label>
                    <input asp-for="Product.Name" class="form-control" />
                    <span asp-validation-for="Product.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Product.Sku" class="form-label">Stok Kodu <span class="text-danger">*</span></label>
                    <input asp-for="Product.Sku" class="form-control" />
                    <span asp-validation-for="Product.Sku" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Product.Barcode" class="form-label">Barkod</label>
                    <input asp-for="Product.Barcode" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Product.CategoryId" class="form-label">Kategori</label>
                    <select asp-for="Product.CategoryId" asp-items="Model.Categories" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Product.BrandId" class="form-label">Marka</label>
                    <select asp-for="Product.BrandId" asp-items="Model.Brands" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Product.OemCodes" class="form-label">OEM Kodları</label>
                    <input asp-for="Product.OemCodes" class="form-control" placeholder="Örnek: 1234, 5678" />
                </div>
                <div class="col-12">
                    <label asp-for="Product.Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Product.Description" class="form-control" rows="2"></textarea>
                </div>

                @* Fiyatlandırma *@
                <div class="col-12 mt-2">
                    <h6 class="fw-semibold text-muted mb-3 border-bottom pb-2">Fiyatlandırma</h6>
                </div>
                <div class="col-md-6">
                    <label asp-for="Product.PurchasePrice" class="form-label">Kart Alış Varsayılanı</label>
                    <div class="input-group">
                        <input asp-for="Product.PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
                        <select asp-for="Product.PurchaseCurrency" class="form-select" style="max-width:90px">
                            <option>TRY</option>
                            <option>USD</option>
                            <option>EUR</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Product.SalePrice" class="form-label">Satış Fiyatı</label>
                    <div class="input-group">
                        <input asp-for="Product.SalePrice" type="number" step="0.01" min="0" class="form-control" />
                        <select asp-for="Product.SaleCurrency" class="form-select" style="max-width:90px">
                            <option>TRY</option>
                            <option>USD</option>
                            <option>EUR</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Product.ProfitMarkupPercent" class="form-label">Kâr Marjı (%)</label>
                    <input asp-for="Product.ProfitMarkupPercent" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="Product.UseCurrentExchangeRateForSale" class="form-check-input" />
                        <label asp-for="Product.UseCurrentExchangeRateForSale" class="form-check-label">Güncel kurla maliyet + marj kullan</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Product.PricingCurrencyCode" class="form-label">Maliyet fiyatlama para birimi</label>
                    <select asp-for="Product.PricingCurrencyCode" class="form-select">
                        <option>TRY</option>
                        <option>USD</option>
                        <option>EUR</option>
                    </select>
                </div>

                @* Stok ve Konum *@
                <div class="col-12 mt-2">
                    <h6 class="fw-semibold text-muted mb-3 border-bottom pb-2">Stok ve Konum</h6>
                </div>
                <div class="col-md-3">
                    <label asp-for="Product.Quantity" class="form-label">Stok Miktarı</label>
                    <input asp-for="Product.Quantity" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Product.Unit" class="form-label">Birim</label>
                    <select asp-for="Product.Unit" class="form-select">
                        <option>Adet</option>
                        <option>Kg</option>
                        <option>Lt</option>
                        <option>Mt</option>
                        <option>Koli</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Product.CriticalStockLevel" class="form-label">Kritik Stok Seviyesi</label>
                    <input asp-for="Product.CriticalStockLevel" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Product.ShelfLocation" class="form-label">Raf / Konum</label>
                    <input asp-for="Product.ShelfLocation" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Product.TrackStock" class="form-check-input" />
                        <label asp-for="Product.TrackStock" class="form-check-label">Stok takibi yap</label>
                    </div>
                </div>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
