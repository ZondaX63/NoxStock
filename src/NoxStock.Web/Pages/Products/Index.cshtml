@page
@using System.Linq
@using System.Globalization
@model NoxStock.Web.Pages.Products.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Ürünler";
}

<div class="products-workspace">
    <header class="products-workspace-header">
        <div>
            <h2>Ürünler</h2>
            <p>Envanteri, onaylı alış maliyetini ve satış fiyatı davranışını aynı çalışma alanından yönetin.</p>
        </div>
        <div class="products-header-actions">
            <button id="ManageProductLookupsButton" type="button" class="products-secondary-action" data-bs-toggle="modal" data-bs-target="#ProductLookupsModal">
                <span class="material-icons-round" aria-hidden="true">category</span>
                Marka &amp; kategori
            </button>
            <button id="ImportProductsButton" type="button" class="products-secondary-action" data-bs-toggle="modal" data-bs-target="#ProductImportModal">
                <span class="material-icons-round" aria-hidden="true">upload_file</span>
                Excel'den aktar
            </button>
            <a asp-page-handler="Export" class="products-secondary-action">
                Excel'e aktar
            </a>
            <button id="NewProductButton" type="button" class="products-primary-action">
                <span class="material-icons-round" aria-hidden="true">add</span>
                Yeni ürün
            </button>
        </div>
    </header>

    @if (TempData["ProductCreated"] is string productCreated)
    {
        <div class="products-feedback products-feedback-success" role="status">
            <span class="material-icons-round" aria-hidden="true">check_circle</span>@productCreated
        </div>
    }

    @if (TempData["ProductImportSummary"] is string importSummary)
    {
        <div class="products-feedback products-feedback-success" role="status">
            <span class="material-icons-round" aria-hidden="true">task_alt</span>
            <div>
                <strong>@importSummary</strong>
                @if (TempData["ProductImportDetails"] is string importDetails && !string.IsNullOrWhiteSpace(importDetails))
                {
                    <small>@importDetails</small>
                }
            </div>
        </div>
    }

    @if (TempData["ProductImportError"] is string importError)
    {
        <div class="products-feedback products-feedback-error" role="alert">
            <span class="material-icons-round" aria-hidden="true">error</span>@importError
        </div>
    }

    <section class="products-overview" aria-label="Ürün özeti">
        <div class="products-overview-card products-overview-primary">
            <span class="material-icons-round" aria-hidden="true">inventory_2</span>
            <div><span>Toplam ürün</span><strong id="ProductVisibleCount">-</strong></div>
        </div>
        <div class="products-overview-card products-overview-dynamic">
            <span class="material-icons-round" aria-hidden="true">currency_exchange</span>
            <div><span>Dinamik fiyatlı</span><strong id="ProductDynamicCount">-</strong></div>
        </div>
        <div class="products-overview-card products-overview-warning">
            <span class="material-icons-round" aria-hidden="true">receipt_long</span>
            <div><span>Maliyet bilgisi olmayan</span><strong id="ProductMissingCostCount">-</strong></div>
        </div>
        <div class="products-overview-card products-overview-danger">
            <span class="material-icons-round" aria-hidden="true">warning_amber</span>
            <div><span>Kritik / sıfır stok</span><strong id="ProductAttentionStockCount">-</strong></div>
        </div>
    </section>

    <div class="modal fade" id="ProductLookupsModal" tabindex="-1" aria-labelledby="ProductLookupsModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg dark:bg-slate-900">
                <div class="modal-header border-b border-slate-200 dark:border-slate-700">
                    <div><p class="products-eyebrow mb-1">ÜRÜN TANIMLARI</p><h5 class="modal-title font-semibold text-slate-900 dark:text-white" id="ProductLookupsModalTitle">Marka ve kategori yönetimi</h5></div>
                    <button type="button" class="btn-close dark:invert" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="flex border-b border-slate-200 p-3 dark:border-slate-700">
                        <button type="button" class="products-quick-filter is-active" data-lookup-manager-tab="brand">Markalar</button>
                        <button type="button" class="products-quick-filter ml-2" data-lookup-manager-tab="category">Kategoriler</button>
                    </div>
                    <div class="p-5">
                        <div class="flex gap-2">
                            <input id="ProductLookupManagerName" type="text" maxlength="150" class="input-field flex-1" placeholder="Yeni marka adı" autocomplete="off" />
                            <button id="ProductLookupManagerAdd" type="button" class="products-primary-action"><span class="material-icons-round" aria-hidden="true">add</span>Ekle</button>
                        </div>
                        <p id="ProductLookupManagerHint" class="mt-2 text-xs text-slate-500">Markalar ürün kartlarında seçim için kullanılır.</p>
                        <div id="ProductLookupManagerList" class="mt-4 max-h-80 divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200 bg-white dark:divide-slate-800 dark:border-slate-700 dark:bg-slate-800" aria-live="polite"></div>
                    </div>
                </div>
                <div class="modal-footer border-t border-slate-200 dark:border-slate-700"><button type="button" class="products-secondary-action" data-bs-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>

    <section id="ProductEditor" class="product-editor-panel" hidden aria-labelledby="ProductEditorTitle">
        <div class="product-editor-header">
            <div>
                <span class="products-eyebrow">YENİ KART</span>
                <h3 id="ProductEditorTitle">Yeni ürün oluştur</h3>
                <p>Kimlik, fiyat davranışı ve açılış stok bilgisini tek akışta tanımlayın.</p>
            </div>
            <div class="product-editor-header-actions">
                <span class="product-keyboard-hint"><kbd>Esc</kbd> Vazgeç · <kbd>Ctrl</kbd> + <kbd>Enter</kbd> Kaydet</span>
                <button id="CloseProductEditor" type="button" class="products-secondary-action product-editor-cancel"><span class="material-icons-round" aria-hidden="true">close</span>Vazgeç</button>
                <button type="submit" form="ProductCreateForm" class="products-primary-action"><span class="material-icons-round" aria-hidden="true">save</span>Kaydet</button>
            </div>
        </div>
        <nav class="product-editor-tabs" aria-label="Ürün kartı bölümleri">
            <button type="button" class="product-editor-tab is-active" data-product-tab="identity"><span class="material-icons-round" aria-hidden="true">badge</span>Temel bilgiler</button>
            <button type="button" class="product-editor-tab" data-product-tab="pricing"><span class="material-icons-round" aria-hidden="true">payments</span>Fiyat &amp; maliyet</button>
            <button type="button" class="product-editor-tab" data-product-tab="stock"><span class="material-icons-round" aria-hidden="true">shelves</span>Stok &amp; raf</button>
        </nav>
        <form id="ProductCreateForm" method="post" asp-page-handler="Create" class="product-editor-form">
            <div asp-validation-summary="ModelOnly" class="products-validation" role="alert"></div>
            <div class="product-editor-grid">
                <section id="ProductSectionIdentity" class="product-editor-section product-editor-identity" data-product-section="identity">
                    <div class="product-editor-section-heading"><span class="material-icons-round" aria-hidden="true">badge</span><div><h4>Kart bilgileri</h4><p>Arama ve ürünün farklı marka alternatifleri için temel kayıt.</p></div></div>
                    <div class="product-form-grid product-form-grid-2">
                        <div class="product-field product-field-wide"><label asp-for="Product.Name">Ürün adı</label><input asp-for="Product.Name" class="input-field" autocomplete="off" /><span asp-validation-for="Product.Name"></span></div>
                        <div class="product-field"><label asp-for="Product.Sku">Stok kodu <small>(boşsa otomatik)</small></label><div class="product-code-input"><input asp-for="Product.Sku" class="input-field" autocomplete="off" /><button id="GenerateProductSku" type="button" title="Yeni stok kodu üret" aria-label="Otomatik stok kodu üret"><span class="material-icons-round" aria-hidden="true">auto_awesome</span></button></div></div>
                        <div class="product-field"><label asp-for="Product.Barcode">Barkod</label><input asp-for="Product.Barcode" class="input-field" inputmode="numeric" autocomplete="off" /></div>
                        <div class="product-field"><label asp-for="Product.CategoryId">Kategori</label><select asp-for="Product.CategoryId" asp-items="Model.Categories" class="input-field"></select></div>
                        <div class="product-field"><label asp-for="Product.BrandId">Marka</label><select asp-for="Product.BrandId" asp-items="Model.Brands" class="input-field"></select></div>
                        <div class="product-field product-field-wide"><label asp-for="Product.OemCodes">OEM / referans kodları</label><input asp-for="Product.OemCodes" placeholder="34116775277, 34 11 6 775 277" class="input-field" autocomplete="off" /><small>Virgülle ayırın. Aynı OEM kodu farklı markalardaki ürünleri birlikte bulur.</small></div>
                        <div class="product-field product-field-wide"><label asp-for="Product.Description">Açıklama</label><textarea asp-for="Product.Description" rows="3" class="input-field"></textarea></div>
                    </div>
                </section>

                <section id="ProductSectionPricing" class="product-editor-section product-editor-pricing" data-product-section="pricing">
                    <div class="product-editor-section-heading"><span class="material-icons-round" aria-hidden="true">payments</span><div><h4>Fiyatlandırma</h4><p>Manuel fiyatı ya da maliyet bazlı dinamik satış davranışını seçin.</p></div></div>
                    <div class="product-pricing-mode-note">
                        <span class="material-icons-round" aria-hidden="true">info</span>
                        <p>Dinamik modda satış fiyatı, yalnızca onaylı alış maliyeti oluştuğunda POS ve faturada güncel kurla hesaplanır.</p>
                    </div>
                    <div class="product-form-grid product-form-grid-2">
                        <div class="product-field"><label asp-for="Product.PricingMode">Fiyatlandırma modu</label><div class="product-pricing-mode-picker" data-pricing-mode-picker><button type="button" class="product-pricing-mode-option" data-pricing-mode="0"><span class="material-icons-round" aria-hidden="true">sell</span><span><strong>Manuel fiyat</strong><small>Satış fiyatını siz belirlersiniz.</small></span></button><button type="button" class="product-pricing-mode-option" data-pricing-mode="1"><span class="material-icons-round" aria-hidden="true">currency_exchange</span><span><strong>Döviz bazlı dinamik</strong><small>Güncel kur ve markup ile hesaplanır.</small></span></button></div><select asp-for="Product.PricingMode" class="product-pricing-mode-select" aria-hidden="true" tabindex="-1"><option value="0">Manuel fiyat</option><option value="1">Döviz bazlı dinamik</option></select></div>
                        <div class="product-field"><label asp-for="Product.ProfitMarkupPercent">Maliyet üzeri kâr ekleme oranı (Markup %)</label><input id="Product_ProfitMarkupPercent" name="Product.ProfitMarkupPercent" value="@Model.Product.ProfitMarkupPercent.ToString("0", CultureInfo.InvariantCulture)" type="number" min="0" step="1" class="input-field" /></div>
                        <div class="product-field product-pricing-context-field" data-pricing-manual-field="sale-price"><label asp-for="Product.SalePrice">Manuel satış fiyatı (TL)</label><input id="Product_SalePrice" name="Product.SalePrice" value="@Model.Product.SalePrice.ToString("0.####", CultureInfo.InvariantCulture)" type="number" step="1" min="0" class="input-field" /><small class="product-pricing-context-help">Yalnızca manuel fiyat modunda kullanılır; tüm satışlar TL'dir.</small></div>
                        <div class="product-field product-pricing-context-field"><label asp-for="Product.PurchasePrice">Kart alış fiyatı / maliyet simülasyonu</label><div class="product-money-input"><input id="Product_PurchasePrice" name="Product.PurchasePrice" value="@Model.Product.PurchasePrice.ToString("0.####", CultureInfo.InvariantCulture)" type="number" step="1" min="0" class="input-field" /><select asp-for="Product.PurchaseCurrency"><option>TRY</option><option>USD</option><option>EUR</option></select></div><small id="PurchaseTryEquivalent"></small><small class="product-pricing-context-help">Dinamik maliyet kaynağı değildir; maliyet yalnızca onaylı alış faturasından gelir.</small></div>
                        <div class="product-field product-field-wide">
                            <label>Alış faturası kademeli iskonto simülasyonu</label>
                            <div class="product-discount-matrix" data-discount-matrix="purchase">
                                <label><span>İsk. 1</span><input type="number" min="0" max="100" step="0.01" value="0" class="input-field" aria-label="Alış iskontosu 1" /><b>%</b></label>
                                <span class="material-icons-round" aria-hidden="true">east</span>
                                <label><span>İsk. 2</span><input type="number" min="0" max="100" step="0.01" value="0" class="input-field" aria-label="Alış iskontosu 2" /><b>%</b></label>
                                <span class="material-icons-round" aria-hidden="true">east</span>
                                <label><span>İsk. 3</span><input type="number" min="0" max="100" step="0.01" value="0" class="input-field" aria-label="Alış iskontosu 3" /><b>%</b></label>
                                <span class="material-icons-round" aria-hidden="true">east</span>
                                <label><span>İsk. 4</span><input type="number" min="0" max="100" step="0.01" value="0" class="input-field" aria-label="Alış iskontosu 4" /><b>%</b></label>
                            </div>
                            <small>İndirimler sırayla uygulanır. Bu alan kart önizlemesidir; resmi maliyet onaylı alış faturasında oluşur.</small>
                        </div>
                        <div class="product-field"><label for="ProductPreviewVatRate">KDV oranı</label><select id="ProductPreviewVatRate" class="input-field"><option value="0">%0</option><option value="1">%1</option><option value="10">%10</option><option value="20" selected>%20</option></select><small>KDV dahil satış görünümünü hesaplar.</small></div>
                        <div class="product-field product-preview-field"><label>Anlık hesaplama</label><button id="CalculateSalePrice" type="button" class="products-secondary-action"><span class="material-icons-round" aria-hidden="true">calculate</span>Dinamik modu seç</button><small id="SaleCalculationInfo">Sağdaki finansal özet her değişiklikte otomatik güncellenir.</small></div>
                    </div>
                    <input asp-for="Product.UseCurrentExchangeRateForSale" type="hidden" value="false" />
                </section>

                <section id="ProductSectionStock" class="product-editor-section product-editor-stock" data-product-section="stock">
                    <div class="product-editor-section-heading"><span class="material-icons-round" aria-hidden="true">shelves</span><div><h4>Stok ve konum</h4><p>Açılış miktarı ile kritik seviye, ürün kartının başlangıç bilgisidir.</p></div></div>
                    <div class="product-form-grid product-form-grid-2">
                        <div class="product-field"><label asp-for="Product.Quantity">Açılış stoğu</label><input id="Product_Quantity" name="Product.Quantity" value="@Model.Product.Quantity.ToString("0", CultureInfo.InvariantCulture)" type="number" step="1" class="input-field" /></div>
                        <div class="product-field"><label asp-for="Product.Unit">Birim</label><select asp-for="Product.Unit" class="input-field"><option>Adet</option><option>Kg</option><option>Lt</option><option>Mt</option><option>Koli</option></select></div>
                        <div class="product-field"><label asp-for="Product.CriticalStockLevel">Kritik stok</label><input id="Product_CriticalStockLevel" name="Product.CriticalStockLevel" value="@Model.Product.CriticalStockLevel.ToString("0", CultureInfo.InvariantCulture)" type="number" step="1" min="0" class="input-field" /></div>
                        <div class="product-field"><label asp-for="Product.ShelfLocation">Raf / konum</label><input asp-for="Product.ShelfLocation" class="input-field" autocomplete="off" /></div>
                    </div>
                    <label class="product-checkbox"><input asp-for="Product.TrackStock" /> <span>Bu ürün için stok takibi yap</span></label>
                    <button type="submit" class="products-primary-action product-editor-submit"><span class="material-icons-round" aria-hidden="true">save</span>Ürün kartını oluştur</button>
                </section>

                <aside class="product-finance-hero" aria-live="polite" aria-label="Canlı maliyet ve kâr özeti">
                    <div class="product-finance-hero-head">
                        <div><span class="products-eyebrow">CANLI FİNANSAL ÖZET</span><h4>Fiyat tutarlılık kontrolü</h4></div>
                        <span class="product-live-badge"><i></i>Canlı</span>
                    </div>
                    <div class="product-finance-main">
                        <span>Net TL kart maliyeti</span>
                        <strong id="ProductHeroNetCost">₺0,00</strong>
                        <small id="ProductHeroCostMeta">Alış fiyatı ve kur bilgisini girin.</small>
                    </div>
                    <dl class="product-finance-breakdown">
                        <div><dt>Liste satış</dt><dd id="ProductHeroListSale">₺0,00</dd></div>
                        <div><dt>Satış iskontosu</dt><dd id="ProductHeroSaleDiscount">-₺0,00</dd></div>
                        <div><dt>KDV hariç net satış</dt><dd id="ProductHeroNetSale">₺0,00</dd></div>
                        <div><dt>KDV dahil fiyat</dt><dd id="ProductHeroVatSale">₺0,00</dd></div>
                    </dl>
                    <div class="product-finance-profit" data-profit-state="neutral">
                        <span>Tahmini net kâr</span>
                        <strong id="ProductHeroProfit">₺0,00</strong>
                        <small id="ProductHeroMargin">%0,00 marj</small>
                    </div>
                    <div class="product-finance-integrity">
                        <span class="material-icons-round" aria-hidden="true">verified_user</span>
                        <p><strong>Muhasebe bütünlüğü korunur.</strong> Bu kart bir karar önizlemesidir. Gerçek geliş maliyeti onaylı alış faturasıyla, gerçek satış fiyatı belge satırında kilitlenir.</p>
                    </div>
                </aside>
            </div>
        </form>
    </section>

    <section class="products-list-shell" aria-labelledby="ProductsListTitle">
        <div class="products-list-heading">
            <div><span class="products-eyebrow">ENVANTER</span><h3 id="ProductsListTitle">Ürün kataloğu</h3> </div>
        </div>
        <div class="products-quick-filters" role="group" aria-label="Hızlı ürün filtreleri">
            <button type="button" class="products-quick-filter is-active" data-quick-filter="all"><span class="material-icons-round" aria-hidden="true">apps</span>Tümü</button>
            <button type="button" class="products-quick-filter" data-quick-filter="dynamic"><span class="material-icons-round" aria-hidden="true">currency_exchange</span>Dinamik fiyatlı</button>
            <button type="button" class="products-quick-filter" data-quick-filter="manual"><span class="material-icons-round" aria-hidden="true">sell</span>Manuel fiyatlı</button>
            <button type="button" class="products-quick-filter" data-quick-filter="missing-cost"><span class="material-icons-round" aria-hidden="true">receipt_long</span>Maliyeti olmayan</button>
            <button type="button" class="products-quick-filter" data-quick-filter="incomplete"><span class="material-icons-round" aria-hidden="true">edit_note</span>Eksik bilgili</button>
            <button type="button" class="products-quick-filter" data-quick-filter="attention-stock"><span class="material-icons-round" aria-hidden="true">warning_amber</span>Stok uyarısı</button>
        </div>
        <div class="products-filter-panel">
            <div class="product-search-field"><span class="material-icons-round" aria-hidden="true">search</span><input id="ProductSearch" type="search" placeholder="Ürün adı, stok kodu, barkod veya OEM ara" autocomplete="off" /></div>
            <select id="ProductBrandFilter" class="input-field" aria-label="Marka filtresi"><option value="">Tüm markalar</option>@foreach (var brand in Model.Brands.Skip(1)) { <option value="@brand.Value">@brand.Text</option> }</select>
            <select id="ProductCategoryFilter" class="input-field" aria-label="Kategori filtresi"><option value="">Tüm kategoriler</option>@foreach (var category in Model.Categories.Skip(1)) { <option value="@category.Value">@category.Text</option> }</select>
            <select id="ProductStockStatusFilter" class="input-field" aria-label="Stok durumu filtresi"><option value="">Tüm stok durumları</option><option value="attention">Kritik veya sıfır stok</option><option value="critical">Kritik stok</option><option value="zero">Sıfır stok</option><option value="normal">Normal stok</option><option value="untracked">Stok takibi kapalı</option></select>
            <select id="ProductPricingModeFilter" class="input-field" aria-label="Fiyatlandırma modu filtresi"><option value="">Tüm fiyatlandırmalar</option><option value="dynamic">Döviz bazlı dinamik</option><option value="manual">Manuel fiyat</option></select>
            <select id="ProductCostStatusFilter" class="input-field" aria-label="Maliyet durumu filtresi"><option value="">Tüm maliyet durumları</option><option value="incomplete">Eksik bilgili ürün</option><option value="available">Onaylı maliyeti olan</option><option value="missing">Maliyet bilgisi olmayan</option><option value="under-cost">Maliyetin altında satma riski</option><option value="recent">Son 30 gün maliyet değişen</option></select>
            <button id="ResetProductFilters" type="button" class="products-reset-action"><span class="material-icons-round" aria-hidden="true">restart_alt</span><span>Temizle</span></button>
        </div>
        <p class="products-search-help"><span class="material-icons-round" aria-hidden="true">tips_and_updates</span>OEM araması boşluk ve tireleri yok sayar; aynı referans numaralı tüm marka alternatifleri birlikte listelenir.</p>
        <div class="products-table-tools">
            <div class="products-currency-view" aria-labelledby="ProductCurrencyViewLabel">
                <span class="material-icons-round" aria-hidden="true">currency_exchange</span>
                <div class="products-currency-view-copy"><strong id="ProductCurrencyViewLabel">Fiyat görünümü</strong><small id="ProductCurrencyViewHint">Satış ve maliyetler yalnızca TL gösteriliyor.</small></div>
                <div class="products-segmented-control" role="group" aria-label="Fiyat para birimi görünümü">
                    <button type="button" data-currency-view="try" aria-pressed="true">Yalnızca TL</button>
                    <button type="button" data-currency-view="reference" aria-pressed="false">TL + referans</button>
                </div>
            </div>
            <div class="relative inline-block text-left" id="ColumnToggleWrapper">
                <button type="button" id="ToggleColumnsBtn" class="products-column-trigger" aria-haspopup="true" aria-expanded="false">
                    <span class="material-icons-round text-sm">view_column</span>
                    Kolonları özelleştir
                </button>
                <div id="ColumnToggleMenu" class="products-column-menu hidden" role="menu" aria-label="Ürün kolonları">
                    <div class="products-column-menu-heading"><strong>Kolon görünümü</strong><span>Günlük kullanım için gereken alanları seçin. Başlık kenarını sürükleyerek genişliği ayarlayabilirsiniz.</span></div>
                    <div class="products-column-menu-grid">
                        <div>
                            <p>Günlük görünüm</p>
                            <label><input type="checkbox" class="col-toggle" data-column="2" checked> Stok</label>
                            <label><input type="checkbox" class="col-toggle" data-column="3" checked> Fiyat politikası</label>
                            <label><input type="checkbox" class="col-toggle" data-column="5" checked> Güncel net TL maliyet</label>
                            <label><input type="checkbox" class="col-toggle" data-column="6" checked> Güncel TL satış fiyatı</label>
                            <label><input type="checkbox" class="col-toggle" data-column="15" checked> Raf / konum</label>
                            <label><input type="checkbox" class="col-toggle" data-column="7"> Marka / kategori</label>
                        </div>
                        <div>
                            <p>Belge ve kod ayrıntıları</p>
                            <label><input type="checkbox" class="col-toggle" data-column="4"> Maliyet kaynağı / fatura</label>
                            <label><input type="checkbox" class="col-toggle" data-column="8"> Barkod</label>
                            <label><input type="checkbox" class="col-toggle" data-column="9"> OEM kodları</label>
                            <label><input type="checkbox" class="col-toggle" data-column="10"> Son alış tarihi</label>
                            <label><input type="checkbox" class="col-toggle" data-column="13"> Alış günü TL maliyeti</label>
                        </div>
                    </div>
                    <div class="products-column-menu-note"><span class="material-icons-round" aria-hidden="true">info</span>Kaynak döviz tutarı, fatura kuru ve referans satış kolonları “TL + referans” görünümünden birlikte yönetilir.</div>
                    <button type="button" id="ResetProductColumns" class="products-column-menu-reset"><span class="material-icons-round" aria-hidden="true">restart_alt</span>Görünüm ve genişlikleri sıfırla</button>
                </div>
            </div>
        </div>
        <div class="products-table-wrap" data-products-table-shell>
            <div id="ProductsTableLoading" class="products-table-loading is-visible" role="status" aria-live="polite"><span></span><span>Ürünler yükleniyor…</span></div>
            <table id="ProductsTable" class="product-data-table w-full text-left text-sm">
                <thead><tr><th>İşlem</th><th>Ürün ve kodlar</th><th>Stok</th><th>Fiyat politikası</th><th>Maliyet kaynağı / fatura</th><th>Güncel net TL maliyet</th><th>Güncel TL satış fiyatı</th><th>Marka / kategori</th><th>Barkod</th><th>OEM kodları</th><th>Son alış tarihi</th><th>Net alış (kaynak döviz)</th><th>Alış fatura kuru</th><th>Alış günü TL maliyeti</th><th>Referans satış fiyatı</th><th>Raf / konum</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </section>
</div>

<div class="modal fade product-import-modal" id="ProductImportModal" tabindex="-1" aria-labelledby="ProductImportModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="ProductImportForm" method="post" asp-page-handler="Import" enctype="multipart/form-data">
                <div class="modal-header">
                    <div><span class="products-eyebrow">TOPLU ÜRÜN AKTARIMI</span><h5 class="modal-title" id="ProductImportModalTitle">Excel stok sayımını içe aktar</h5></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <label class="product-import-dropzone" for="ImportFile">
                        <span class="material-icons-round" aria-hidden="true">table_view</span>
                        <strong>.xlsx dosyasını seçin</strong>
                        <small id="ProductImportFileName">En fazla 10 MB</small>
                        <input asp-for="ImportFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                    </label>
                    <div class="product-import-rules">
                        <strong>Aktarım kuralları</strong>
                        <ul>
                            <li>Yalnızca <b>Ürün Adı</b> zorunludur; boş stok kodu otomatik üretilir.</li>
                            <li>Aynı stok kodunun ilk satırı alınır; stok miktarı iki kez eklenmez.</li>
                            <li>Mevcut stok kodunda miktar ve dolu operasyon bilgileri güncellenir.</li>
                            <li>Boş marka, kategori, barkod, raf ve açıklama aktarımı engellemez.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="products-secondary-action" data-bs-dismiss="modal">Vazgeç</button>
                    <button id="SubmitProductImport" type="submit" class="products-primary-action"><span class="material-icons-round" aria-hidden="true">upload</span>Aktarımı başlat</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <abp-script src="/Pages/Products/Index.js" /> }
