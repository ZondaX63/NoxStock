@page
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NoxStock.Web.Pages.Accounts.TransferModalModel
@{
    Layout = null;
}

<form asp-page="/Accounts/TransferModal" class="finance-modal-form">
    <abp-modal>
        <abp-modal-header title="Hesaplar Arası Transfer (Virman)"></abp-modal-header>
        <abp-modal-body class="finance-modal-body">
            <div class="finance-modal-intro finance-modal-intro-blue"><span class="material-icons-round">swap_horiz</span><div><strong>Hesaplar arası virman</strong><small>Para, kaynak hesaptan düşülür ve hedef hesaba aynı anda aktarılır.</small></div></div>
            <div class="finance-transfer-flow">
                <div><span>1</span><abp-select asp-for="Transfer.FromAccountId" asp-items="Model.Accounts" label="Kaynak Hesap" /></div>
                <i class="material-icons-round" aria-hidden="true">arrow_downward</i>
                <div><span>2</span><abp-select asp-for="Transfer.ToAccountId" asp-items="Model.Accounts" label="Hedef Hesap" /></div>
            </div>
            <div class="finance-form-grid mt-3">
                <abp-input asp-for="Transfer.Amount" label="Tutar" />
                <abp-input asp-for="Transfer.Date" label="Tarih" />
                <div class="finance-field-wide"><abp-input asp-for="Transfer.Description" label="Açıklama" /></div>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
