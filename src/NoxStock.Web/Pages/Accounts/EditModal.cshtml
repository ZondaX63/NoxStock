@page
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NoxStock.Web.Pages.Accounts.EditModalModel
@{
    Layout = null;
}

<form asp-page="/Accounts/EditModal" class="finance-modal-form">
    <abp-modal>
        <abp-modal-header title="Hesap Düzenle"></abp-modal-header>
        <abp-modal-body class="finance-modal-body">
            <abp-input asp-for="Id" />
            <div class="finance-modal-intro finance-modal-intro-indigo"><span class="material-icons-round">manage_accounts</span><div><strong>Hesap ayarlarını güncelleyin</strong><small>Tür, para birimi ve kullanım durumunu tek yerden yönetin.</small></div></div>
            <div class="finance-form-grid">
                <div class="finance-field-wide"><abp-input asp-for="Account.Name" label="Hesap Adı" /></div>
                <abp-select asp-for="Account.Type" asp-items="Model.AccountTypes" label="Hesap Türü" />
                <abp-input asp-for="Account.Currency" label="Para Birimi" />
            </div>
            <div class="finance-modal-toggle"><abp-input asp-for="Account.IsActive" label="Hesap kullanımına açık" /></div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
