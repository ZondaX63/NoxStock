@page
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NoxStock.Web.Pages.Accounts.AddTransactionModalModel
@{
    Layout = null;
}

<form asp-page="/Accounts/AddTransactionModal">
    <abp-modal>
        <abp-modal-header title="İşlem Ekle (Gelir/Gider)"></abp-modal-header>
        <abp-modal-body>
            <abp-select asp-for="Transaction.AccountId" asp-items="Model.Accounts" label="İşlem Yapılacak Hesap" />
            <abp-select asp-for="Transaction.Type" asp-items="Model.TransactionTypes" label="İşlem Tipi" />
            <abp-input asp-for="Transaction.Amount" label="Tutar" />
            <abp-input asp-for="Transaction.Date" label="Tarih" />
            <abp-input asp-for="Transaction.Description" label="Açıklama" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
