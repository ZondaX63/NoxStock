@using Volo.Abp.Users
@using NoxStock.Localization
@using System.Linq
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.MultiTenancy
@model NoxStock.Web.Components.AppTopbar.AppTopbarViewModel
@inject ICurrentUser CurrentUser
@inject ICurrentTenant CurrentTenant
@inject IHtmlLocalizer<NoxStockResource> L

@{
    var isTenantUser = CurrentUser.TenantId.HasValue;
    var displayName = isTenantUser
        ? CurrentUser.Email ?? CurrentUser.UserName ?? L["Topbar:User"].Value
        : CurrentUser.UserName ?? L["Topbar:User"].Value;
    var accountContext = isTenantUser
        ? CurrentTenant.Name ?? L["Topbar:CompanyAccount"].Value
        : L["Topbar:PlatformManagement"].Value;
    var initials = displayName.Substring(0, Math.Min(2, displayName.Length)).ToUpper();
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var encodedReturnUrl = Uri.EscapeDataString(returnUrl);
    var alertsEndpoint = (Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : string.Empty) + "/api/app/operational-alerts/summary";
    var alertsCacheContext = $"{Context.Request.PathBase}:{CurrentUser.Id?.ToString("N")}";
}

<header class="app-topbar bg-white/95 dark:bg-slate-900/95 border-b border-slate-200 dark:border-slate-700 h-16 flex items-center justify-between px-4 sm:px-6 lg:px-8 sticky top-0 z-20 transition-colors duration-200">
    <div class="flex min-w-0 items-center gap-3">
        <button @@click="sidebarOpen = !sidebarOpen" class="p-2 -ml-2 rounded-lg text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500 lg:hidden">
            <span class="material-icons-round">menu</span>
        </button>
        <span class="hidden h-8 w-8 lg:block" aria-hidden="true"></span>
    </div>
    
    <div class="flex items-center gap-2 sm:gap-4">
        <div class="hidden rounded-md border border-slate-200 bg-white p-1 text-xs font-semibold dark:border-slate-700 dark:bg-slate-800 sm:flex">
            <a href="~/Abp/Languages/Switch?culture=tr&uiCulture=tr&returnUrl=@encodedReturnUrl" class="rounded px-2 py-1 @(currentCulture == "tr" ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900" : "text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white")">TR</a>
            <a href="~/Abp/Languages/Switch?culture=en&uiCulture=en&returnUrl=@encodedReturnUrl" class="rounded px-2 py-1 @(currentCulture == "en" ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900" : "text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white")">EN</a>
        </div>
        <div id="CurrencyTicker"
             class="hidden items-center gap-3 rounded-md border border-indigo-100 bg-indigo-50/70 px-2 py-1.5 text-xs dark:border-slate-700 dark:bg-slate-800 md:flex"
             title="@L["Topbar:CurrencyTooltip"]"
             data-ticker-updated="@L["Topbar:RatesUpdated"]"
             data-ticker-pending="@L["Topbar:RatesPending"]"
             data-ticker-error="@L["Topbar:RatesUnavailable"]">
            <label for="CurrencyTickerMode" class="sr-only">Döviz gösterimi</label>
            <select id="CurrencyTickerMode" class="bg-transparent pr-5 text-xs font-bold text-indigo-700 outline-none dark:text-indigo-300">
                <option value="both">USD / EUR</option>
                <option value="usd">USD</option>
                <option value="eur">EUR</option>
            </select>
            <div data-currency-ticker-item="usd"><span class="font-semibold text-indigo-500">USD</span><span id="CurrencyTickerUsd" class="ml-1.5 font-bold text-slate-700 dark:text-slate-200">--</span></div>
            <div data-currency-ticker-separator class="h-4 w-px bg-indigo-200 dark:bg-slate-600"></div>
            <div data-currency-ticker-item="eur"><span class="font-semibold text-indigo-500">EUR</span><span id="CurrencyTickerEur" class="ml-1.5 font-bold text-slate-700 dark:text-slate-200">--</span></div>
            <span id="CurrencyTickerUpdated" class="sr-only">@L["Topbar:Loading"]</span>
        </div>
        
        <button @@click="darkMode = !darkMode" class="p-2 rounded-full text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-slate-800 transition-colors focus:outline-none" title="@L["Topbar:Theme"]">
            <span class="material-icons-round" x-text="darkMode ? 'light_mode' : 'dark_mode'"></span>
        </button>

        @if (Model.CanReadNotifications)
        {
            <div class="relative"
                 x-data="{ showNotifications: false }"
                 data-topbar-alerts
                 data-alerts-endpoint="@alertsEndpoint"
                 data-alerts-cache-context="@alertsCacheContext"
                 data-alerts-loading="@L["Topbar:Loading"]"
                 data-alerts-empty="@L["Topbar:NoOpenNotifications"]"
                 data-alerts-error="@L["Topbar:NotificationsUnavailable"]">
                <button type="button"
                        data-alerts-trigger
                        @@click="showNotifications = !showNotifications"
                        @@click.away="showNotifications = false"
                        class="relative p-2 rounded-full text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-slate-800 transition-colors focus:outline-none"
                        aria-label="@L["Topbar:Notifications"]">
                    <span data-alerts-count class="absolute -right-1 -top-1 hidden min-w-5 rounded-full bg-red-500 px-1 text-center text-[10px] font-bold leading-5 text-white ring-2 ring-white">0</span>
                    <span class="material-icons-round">notifications</span>
                </button>

                <div x-show="showNotifications"
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     class="absolute right-0 z-50 mt-2 w-80 rounded-xl bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 dark:bg-slate-800"
                     style="display: none;">
                    <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3 dark:border-slate-700">
                        <h3 class="text-sm font-semibold text-gray-900 dark:text-white">@L["Topbar:Notifications"]</h3>
                        <a href="~/Notifications" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700">@L["Topbar:ViewAllNotifications"]</a>
                    </div>
                    <div data-alerts-loading-state class="px-4 py-6 text-center text-sm text-slate-400">
                        <span class="inline-block animate-pulse">@L["Topbar:Loading"]</span>
                    </div>
                    <div data-alerts-list class="hidden max-h-64 overflow-y-auto"></div>
                    <div data-alerts-empty-state class="hidden px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">@L["Topbar:NoOpenNotifications"]</div>
                    <div data-alerts-error-state class="hidden px-4 py-6 text-center text-sm text-amber-600 dark:text-amber-300">@L["Topbar:NotificationsUnavailable"]</div>
                </div>
            </div>
        }

        <div class="flex items-center pl-3 sm:pl-4 border-l border-slate-200 dark:border-slate-700">
            <div class="flex flex-col items-end mr-3 hidden md:flex">
                <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">@displayName</span>
                <span class="text-xs text-slate-500">@accountContext</span>
            </div>
            <div class="h-10 w-10 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold shadow-lg shadow-indigo-500/30 ring-2 ring-white cursor-pointer">
                @initials
            </div>
        </div>
    </div>
</header>
