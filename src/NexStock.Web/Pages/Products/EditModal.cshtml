@page
@using Microsoft.AspNetCore.Mvc.Localization
@using NexStock.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IHtmlLocalizer<NexStockResource> L
@model NexStock.Web.Pages.Products.EditModalModel
@{
    Layout = null;
}

<form asp-page="/Products/EditModal">
    <input asp-for="Product.Currency" type="hidden" />
    <input asp-for="Product.PurchaseCurrency" type="hidden" />
    <input asp-for="Product.SaleCurrency" type="hidden" />
    <abp-modal size="Large">
        <abp-modal-header title="@L["Update"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Product.Name" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="Product.Sku" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_6">
                    <abp-select asp-for="Product.BrandId" asp-items="Model.Brands" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-select asp-for="Product.CategoryId" asp-items="Model.Categories" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_4">
                    <abp-input asp-for="Product.SalePrice" />
                </abp-column>
                <abp-column size-md="_4">
                    <abp-input asp-for="Product.PurchasePrice" />
                </abp-column>
                <abp-column size-md="_4">
                    <abp-input asp-for="Product.Quantity" />
                </abp-column>
            </abp-row>
            <abp-input asp-for="Product.OemCodes" label="OEM Kodları" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
