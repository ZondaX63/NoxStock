@page
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NexStock.Web.Pages.Accounts.EditModalModel
@{
    Layout = null;
}

<form asp-page="/Accounts/EditModal">
    <abp-modal>
        <abp-modal-header title="Hesap Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-input asp-for="Account.Name" label="Hesap Adı" />
            <abp-select asp-for="Account.Type" asp-items="Model.AccountTypes" label="Hesap Türü" />
            <abp-input asp-for="Account.Currency" label="Para Birimi" />
            <abp-input asp-for="Account.IsActive" label="Aktif" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
