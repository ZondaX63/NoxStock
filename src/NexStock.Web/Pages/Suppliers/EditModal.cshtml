@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NexStock.Web.Pages.Suppliers.EditModalModel
@{
    Layout = null;
}

<form asp-page="/Suppliers/EditModal">
    <abp-modal>
        <abp-modal-header title="Tedarikçi Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-input asp-for="Supplier.Name" label="Adı Soyadı / Ünvan" />
            <abp-input asp-for="Supplier.Email" label="E-Posta" />
            <abp-input asp-for="Supplier.Phone" label="Telefon" />
            <abp-input asp-for="Supplier.TaxOffice" label="Vergi Dairesi" />
            <abp-input asp-for="Supplier.TaxNumber" label="Vergi Numarası / TCKN" />
            <abp-input asp-for="Supplier.Address" label="Adres" />
            <abp-input asp-for="Supplier.CreditLimit" label="Kredi Limiti" />
            <abp-input asp-for="Supplier.Currency" label="Para Birimi" />
            <input type="hidden" asp-for="Supplier.Type" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
