@page
@using Microsoft.AspNetCore.Mvc.Localization
@using NexStock.Localization
@model NexStock.Web.Pages.Account.LoginModel
@inject IHtmlLocalizer<NexStockResource> L
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Auth:Login"].Value;
    var isTenantLogin = CurrentTenant.Id.HasValue;
    var title = isTenantLogin ? L["Auth:TenantLoginTitle"] : L["Auth:HostLoginTitle"];
    var description = isTenantLogin ? L["Auth:TenantLoginDescription"] : L["Auth:HostLoginDescription"];
    var supportText = isTenantLogin ? L["Auth:TenantLoginSupport"] : L["Auth:HostLoginSupport"];
}

<div class="mb-8 text-left">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">@title</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">@description</p>
</div>

<form method="post" class="space-y-5">
    <input asp-for="ReturnUrl" type="hidden" />
    <input asp-for="ReturnUrlHash" type="hidden" />
    
    <div asp-validation-summary="ModelOnly" class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200"></div>
    
    <div class="space-y-1">
        <label asp-for="LoginInput.UserNameOrEmailAddress" class="block text-sm font-bold text-slate-700 ml-1">@L["Auth:UserNameOrEmail"]</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <span class="material-icons-round text-xl">person</span>
            </div>
            <input asp-for="LoginInput.UserNameOrEmailAddress" autocomplete="username" class="auth-input block w-full rounded-md pl-10 pr-3 py-3 text-sm outline-none" placeholder="@L["Auth:UserNameOrEmailPlaceholder"]" />
        </div>
        <span asp-validation-for="LoginInput.UserNameOrEmailAddress" class="mt-1 block text-xs font-medium text-red-500 ml-1"></span>
    </div>
    
    <div class="space-y-1">
        <div class="flex items-center justify-between ml-1 mr-1">
            <label asp-for="LoginInput.Password" class="block text-sm font-bold text-slate-700">@L["Auth:Password"]</label>
        </div>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <span class="material-icons-round text-xl">lock</span>
            </div>
            <input asp-for="LoginInput.Password" type="password" autocomplete="current-password" class="auth-input block w-full rounded-md pl-10 pr-3 py-3 text-sm outline-none" placeholder="••••••••" />
        </div>
        <span asp-validation-for="LoginInput.Password" class="mt-1 block text-xs font-medium text-red-500 ml-1"></span>
    </div>
    
    <div class="flex items-center justify-between mt-6">
        <label class="flex items-center gap-2 text-sm font-medium text-slate-600 cursor-pointer group">
            <div class="relative flex items-center justify-center">
                <input asp-for="LoginInput.RememberMe" class="peer appearance-none w-5 h-5 border-2 border-slate-300 rounded-md bg-white/50 checked:bg-indigo-600 checked:border-indigo-600 transition-all cursor-pointer" />
                <span class="material-icons-round text-white text-sm absolute opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity">check</span>
            </div>
            <span class="group-hover:text-slate-900 transition-colors">@L["Auth:RememberMe"]</span>
        </label>
    </div>
    
    <button type="submit" class="auth-btn mt-6 flex w-full items-center justify-center gap-2 rounded-md px-4 py-3 text-sm font-bold text-white shadow-md">
        @L["Auth:Login"]
        <span class="material-icons-round text-lg">arrow_forward</span>
    </button>
</form>

<div class="mt-8 border-t border-slate-200 pt-5 dark:border-slate-700">
    <div class="flex gap-3 text-sm text-slate-500 dark:text-slate-400">
        <span class="material-icons-round mt-0.5 text-base text-slate-400">info</span>
        <p>@supportText</p>
    </div>
</div>
