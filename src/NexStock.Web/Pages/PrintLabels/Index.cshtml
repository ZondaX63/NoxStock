@page
@using Microsoft.AspNetCore.Mvc.Localization
@model NexStock.Web.Pages.PrintLabels.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Etiket Yazdır";
}

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white">Etiket ve Barkod Yazdır</h2>
        <p class="text-sm text-slate-500 mt-1">Ürünler için raf etiketleri ve barkodları tek tıkla yazdırın.</p>
    </div>
    <button class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg font-medium transition-all shadow-md shadow-indigo-500/30 flex items-center">
        <span class="material-icons-round mr-2 text-sm">print</span>
        Seçilenleri Yazdır
    </button>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Sol Panel: Ürün Arama ve Seçim -->
    <div class="card p-6 lg:col-span-3 shadow-lg shadow-slate-200/50 dark:shadow-none min-h-[400px] flex flex-col">
        <div class="mb-4">
            <input type="text" placeholder="Barkod okutun veya ürün adı arayın..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>
        <div class="flex-1 flex flex-col items-center justify-center text-slate-400">
            <span class="material-icons-round text-5xl mb-3 opacity-30 block">playlist_add</span>
            <span class="font-medium text-slate-500 text-center max-w-sm">Arama çubuğunu kullanarak veya barkod okutarak yazdırılacak ürünleri listeye ekleyin.</span>
        </div>
    </div>

    <!-- Sağ Panel: Yazdırma Ayarları -->
    <div class="card p-6 lg:col-span-1 shadow-lg shadow-slate-200/50 dark:shadow-none h-fit">
        <h3 class="font-bold text-slate-800 dark:text-white mb-4">Etiket Ayarları</h3>
        
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Şablon Tipi</label>
                <select class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm outline-none">
                    <option>Standart Raf Etiketi (40x25mm)</option>
                    <option>Ürün Barkodu (30x15mm)</option>
                    <option>A4 Etiket Sayfası</option>
                </select>
            </div>
            
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Gösterilecek Alanlar</label>
                <div class="space-y-2">
                    <label class="flex items-center text-sm">
                        <input type="checkbox" checked class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 mr-2">
                        Ürün Adı
                    </label>
                    <label class="flex items-center text-sm">
                        <input type="checkbox" checked class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 mr-2">
                        Barkod (Çizgi veya QR)
                    </label>
                    <label class="flex items-center text-sm">
                        <input type="checkbox" checked class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 mr-2">
                        Satış Fiyatı
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>
