@page
@model NexStock.Web.Pages.Offers.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Teklifler";
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-white sm:text-3xl">Teklifler</h2>
        <p class="text-sm text-slate-500 mt-1">Teklifleri gönderin, siparişe veya satış faturasına dönüştürün.</p>
    </div>
    <a href="~/Invoices/Create?type=Offer" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-md font-medium transition-colors flex items-center justify-center">
        <span class="material-icons-round mr-2 text-sm">add</span>Yeni Teklif
    </a>
</div>

<div class="card overflow-hidden">
    <div class="p-6 overflow-x-auto">
        <table id="OffersTable" class="table w-full text-left whitespace-nowrap">
            <thead>
                <tr>
                    <th>İşlemler</th><th>Teklif No</th><th>Cari Hesap</th><th>Tarih</th><th>Geçerlilik</th><th>Toplam</th><th>Durum</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <abp-script src="/Pages/Offers/Index.js" />
}
