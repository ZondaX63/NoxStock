@page
@using Microsoft.AspNetCore.Mvc.Localization
@model NexStock.Web.Pages.CustomerDetail.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Cari Ekstresi";
}

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white">Cari Ekstre</h2>
        <p class="text-sm text-slate-500 mt-1">Seçili cari hesabın detaylarını ve geçmiş hareketlerini inceleyin.</p>
    </div>
    <div class="flex gap-2">
        <button id="NewCollectionBtn" type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg font-medium transition-all shadow-md shadow-indigo-500/30 flex items-center">
            <span class="material-icons-round mr-2 text-sm">add</span>
            Tahsilat Al
        </button>
        <button id="NewPaymentBtn" type="button" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2.5 rounded-lg font-medium transition-all shadow-md shadow-red-500/30 flex items-center">
            <span class="material-icons-round mr-2 text-sm">remove</span>
            Ödeme Yap
        </button>
        <button id="PrintStatementButton" type="button" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 text-slate-700 dark:text-slate-300 px-4 py-2 rounded-lg font-medium transition-all shadow-sm">
            <span class="material-icons-round text-sm align-middle mr-1">print</span> Yazdır
        </button>
    </div>
</div>

<input type="hidden" id="BusinessPartnerId" value="@Model.Id" />

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <!-- Müşteri Bilgileri -->
    <div class="card p-6 lg:col-span-1 shadow-lg shadow-slate-200/50 dark:shadow-none">
        <div class="flex items-center space-x-4 mb-6">
            <div class="w-14 h-14 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 rounded-full flex items-center justify-center text-xl font-bold">
                <span class="material-icons-round">person</span>
            </div>
            <div>
                <h3 id="BpName" class="text-xl font-bold text-slate-800 dark:text-white">--</h3>
                <p id="BpType" class="text-sm text-slate-500">--</p>
            </div>
        </div>
        <div class="space-y-4 text-sm">
            <div class="flex justify-between border-b border-slate-100 dark:border-slate-700 pb-2">
                <span class="text-slate-500">Telefon:</span>
                <span id="BpPhone" class="font-medium text-slate-800 dark:text-white">--</span>
            </div>
            <div class="flex justify-between border-b border-slate-100 dark:border-slate-700 pb-2">
                <span class="text-slate-500">E-Posta:</span>
                <span id="BpEmail" class="font-medium text-slate-800 dark:text-white">--</span>
            </div>
            <div class="flex justify-between border-b border-slate-100 dark:border-slate-700 pb-2">
                <span class="text-slate-500">TCKN / VKN:</span>
                <span id="BpTaxNumber" class="font-medium text-slate-800 dark:text-white">--</span>
            </div>
        </div>
    </div>

    <!-- Bakiye Özeti -->
    <div class="card p-6 lg:col-span-2 shadow-lg shadow-slate-200/50 dark:shadow-none flex flex-col justify-center">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-6">Bakiye Özeti</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-indigo-50 dark:bg-indigo-900/20 p-4 rounded-xl border border-indigo-100 dark:border-indigo-800/30">
                <p class="text-sm text-indigo-600 dark:text-indigo-400 mb-1 font-medium">Güncel Bakiye</p>
                <p id="BpBalance" class="text-2xl font-black text-indigo-700 dark:text-indigo-300">0.00</p>
            </div>
        </div>
    </div>
</div>

<div class="card overflow-hidden shadow-lg shadow-slate-200/50 dark:shadow-none mb-6">
    <div class="p-6 border-b border-slate-100 dark:border-slate-700">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white">Tahsilat ve Ödeme Geçmişi</h3>
        <p class="text-sm text-slate-500 mt-1">Faturalara bağlı kasa ve banka hareketleri.</p>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left whitespace-nowrap">
            <thead class="bg-slate-50/50 dark:bg-slate-800/50">
                <tr>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">Tarih</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">Fatura</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">Kasa / Banka</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">İşlem</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider text-right">Tutar</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">Açıklama</th>
                </tr>
            </thead>
            <tbody id="BpPaymentHistoryBody" class="divide-y divide-slate-100 dark:divide-slate-700 text-sm">
            </tbody>
        </table>
    </div>
</div>

<!-- Hareket Geçmişi -->
<div class="card overflow-hidden shadow-lg shadow-slate-200/50 dark:shadow-none">
    <div class="p-6 border-b border-slate-100 dark:border-slate-700">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white">Faturalar ve Belgeler</h3>
    </div>
    <div class="p-0">
        <table id="BpDocumentsTable" class="table w-full text-left whitespace-nowrap">
            <thead class="bg-slate-50/50 dark:bg-slate-800/50">
                <tr>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">Belge No</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">Tarih</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">Vade</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider">Tip</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider text-right">Tutar</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider text-right">Ödenen</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider text-right">Kalan</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider text-center">Durum</th>
                </tr>
            </thead>
            <tbody class="text-sm">
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <abp-script src="/Pages/CustomerDetail/Index.js" />
}
