@page
@using Microsoft.AspNetCore.Mvc.Localization
@model NexStock.Web.Pages.Personnel.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Personel Yönetimi";
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white">Personel Yönetimi</h2>
        <p class="text-sm text-slate-500 mt-1">Çalışanlarınızın kartlarını, maaşlarını ve avanslarını yönetin.</p>
    </div>
</div>

<div class="card overflow-hidden shadow-lg shadow-slate-200/50 dark:shadow-none">
    <div class="p-0">
        <table class="table w-full text-left whitespace-nowrap">
            <thead class="bg-slate-50/50 dark:bg-slate-800/50">
                <tr>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Personel Adı</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Görev / Departman</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Telefon</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Maaş Tipi</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">Durum</th>
                    <th class="py-4 px-6 text-slate-500 font-semibold uppercase text-xs tracking-wider border-b border-slate-200">İşlemler</th>
                </tr>
            </thead>
            <tbody class="text-sm">
                <tr>
                    <td colspan="6" class="text-center py-12 text-slate-400">
                        <span class="material-icons-round text-5xl mb-3 opacity-30 block">badge</span>
                        <span class="text-lg font-medium text-slate-500">Hiç personel kaydı bulunamadı.</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
