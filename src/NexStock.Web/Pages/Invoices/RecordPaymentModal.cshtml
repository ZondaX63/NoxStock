@page
@using NexStock.Documents
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model NexStock.Web.Pages.Invoices.RecordPaymentModalModel
@{
    Layout = null;
    var isCollection = Model.Document.Type == DocumentType.SaleInvoice;
    var title = isCollection ? "Tahsilat Kaydet" : "Ödeme Kaydet";
    var outstandingAmount = Model.Document.GrandTotal - Model.Document.PaidAmount;
}

<form asp-page="/Invoices/RecordPaymentModal" method="post">
    <abp-modal>
        <abp-modal-header title="@title"></abp-modal-header>
        <abp-modal-body>
            <input type="hidden" asp-for="DocumentId" />

            <div class="grid grid-cols-2 gap-3 rounded-lg bg-slate-50 dark:bg-slate-800 p-4 mb-5">
                <div>
                    <p class="text-xs text-slate-500">Fatura</p>
                    <p class="text-sm font-semibold text-slate-800 dark:text-white">@Model.Document.DocNumber</p>
                </div>
                <div>
                    <p class="text-xs text-slate-500">Cari Hesap</p>
                    <p class="text-sm font-semibold text-slate-800 dark:text-white truncate">@Model.Document.BusinessPartnerName</p>
                </div>
                <div>
                    <p class="text-xs text-slate-500">Fatura Toplamı</p>
                    <p class="text-sm font-semibold text-slate-800 dark:text-white">@Model.Document.GrandTotal @Model.Document.Currency</p>
                </div>
                <div>
                    <p class="text-xs text-slate-500">Kalan Tutar</p>
                    <p class="text-sm font-bold text-amber-600 dark:text-amber-400">@outstandingAmount @Model.Document.Currency</p>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Payment.AccountId" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Kasa / Banka</label>
                <select asp-for="Payment.AccountId" asp-items="Model.Accounts" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required></select>
                <span asp-validation-for="Payment.AccountId" class="text-sm text-red-600 mt-1 block"></span>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="Payment.Amount" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Tutar (@Model.Document.Currency)</label>
                    <input asp-for="Payment.Amount" type="number" min="0.01" max="@outstandingAmount" step="0.01" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required />
                    <span asp-validation-for="Payment.Amount" class="text-sm text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Payment.PaymentDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">İşlem Tarihi</label>
                    <input asp-for="Payment.PaymentDate" type="date" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required />
                    <span asp-validation-for="Payment.PaymentDate" class="text-sm text-red-600 mt-1 block"></span>
                </div>
            </div>

            <div class="mb-1">
                <label asp-for="Payment.Description" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Açıklama</label>
                <textarea asp-for="Payment.Description" rows="2" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white"></textarea>
                <span asp-validation-for="Payment.Description" class="text-sm text-red-600 mt-1 block"></span>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
