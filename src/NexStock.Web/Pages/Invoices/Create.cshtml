@page
@using NexStock.Documents
@model NexStock.Web.Pages.Invoices.CreateModel
@{
    Layout = "_AppLayout";
    var title = Model.GetDocumentTitle();
    ViewData["Title"] = title;
}

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white">@title</h2>
        <p class="text-sm text-slate-500 mt-1">Belge kalemlerini ve cari hesap bilgilerini eksiksiz doldurun.</p>
    </div>
    <a href="@Model.GetRedirectPage(Model.Type)" class="text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 font-medium flex items-center">
        <span class="material-icons-round text-sm mr-1">arrow_back</span>
        Listeye Dön
    </a>
</div>

<form method="post" id="InvoiceForm" data-currency="@Model.Invoice.Currency" data-default-vat-rate="@Model.DefaultVatRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-use-product-pricing="@Model.UsesSalesPricing.ToString().ToLowerInvariant()">
    <input type="hidden" asp-for="Invoice.Type" />
    <input type="hidden" asp-for="Invoice.Currency" />
    <input type="hidden" asp-for="Invoice.ExchangeRate" />
    
    <div asp-validation-summary="All" class="text-red-600 mb-4 bg-red-50 p-4 rounded-lg"></div>

    <!-- Başlık Bilgileri -->
    <div class="card p-6 mb-6">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-4 border-b border-slate-100 dark:border-slate-700 pb-2">Genel Bilgiler</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div>
                <label asp-for="Invoice.DocNumber" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Belge No</label>
                <input asp-for="Invoice.DocNumber" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required />
            </div>
            <div>
                <label asp-for="Invoice.BusinessPartnerId" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                    @Model.GetPartnerLabel()
                </label>
                <select asp-for="Invoice.BusinessPartnerId" asp-items="Model.BusinessPartners" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required></select>
            </div>
            <div>
                <label asp-for="Invoice.Date" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Tarih</label>
                <input asp-for="Invoice.Date" type="date" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required />
            </div>
            <div>
                <label asp-for="Invoice.DueDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Vade / Geçerlilik Tarihi</label>
                <input asp-for="Invoice.DueDate" type="date" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 dark:bg-slate-800 dark:border-slate-600 dark:text-white" />
            </div>
        </div>
    </div>

    <!-- Kalemler -->
    <div class="card p-0 mb-6 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center">
            <h3 class="text-lg font-bold text-slate-800 dark:text-white">Fatura Kalemleri</h3>
            <button type="button" id="AddRowBtn" class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center">
                <span class="material-icons-round text-sm mr-1">add</span>
                Yeni Satır Ekle
            </button>
        </div>
        <div class="overflow-x-auto">
            <table class="table w-full text-left whitespace-nowrap" id="ItemsTable">
                <thead class="bg-slate-50 dark:bg-slate-800/50">
                    <tr>
                        <th class="py-3 px-4 text-slate-500 font-semibold uppercase text-xs">Ürün</th>
                        <th class="py-3 px-4 text-slate-500 font-semibold uppercase text-xs w-32">Miktar</th>
                        <th class="py-3 px-4 text-slate-500 font-semibold uppercase text-xs w-32">B. Fiyat</th>
                        <th class="py-3 px-4 text-slate-500 font-semibold uppercase text-xs w-24">İskonto %</th>
                        <th class="py-3 px-4 text-slate-500 font-semibold uppercase text-xs w-24">KDV %</th>
                        <th class="py-3 px-4 text-slate-500 font-semibold uppercase text-xs w-32 text-right">Toplam</th>
                        <th class="py-3 px-4 w-12"></th>
                    </tr>
                </thead>
                <tbody id="ItemsTbody">
                    <!-- Satırlar JS ile eklenecek -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Alt Toplamlar ve Kaydet -->
    <div class="flex justify-end mb-12">
        <div class="w-full md:w-1/3 card p-6">
            <div class="space-y-3 text-sm">
                <div class="flex justify-between text-slate-600 dark:text-slate-400">
                    <span>Ara Toplam:</span>
                    <span id="SumSubtotal" class="font-medium">0.00 TRY</span>
                </div>
                <div class="flex justify-between text-slate-600 dark:text-slate-400">
                    <span>İskonto Toplamı:</span>
                    <span id="SumDiscount" class="font-medium text-red-500">0.00 TRY</span>
                </div>
                <div class="flex justify-between text-slate-600 dark:text-slate-400">
                    <span>KDV Toplamı:</span>
                    <span id="SumVat" class="font-medium">0.00 TRY</span>
                </div>
                <div class="flex justify-between text-lg font-bold text-slate-900 dark:text-white pt-3 border-t border-slate-200 dark:border-slate-700">
                    <span>Genel Toplam:</span>
                    <span id="SumGrandTotal">0.00 TRY</span>
                </div>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-4 rounded-lg transition-all shadow-md shadow-indigo-500/30 flex justify-center items-center">
                    <span class="material-icons-round mr-2 text-sm">save</span>
                    Belgeyi Kaydet
                </button>
            </div>
        </div>
    </div>
</form>

<template id="ItemRowTemplate">
    <tr class="item-row border-b border-slate-100 dark:border-slate-700">
        <td class="py-2 px-4">
            <input type="hidden" name="Invoice.Items.Index" value="{id}" />
            <select name="Invoice.Items[{id}].ProductId" class="product-select w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" required>
                @foreach (var opt in Model.Products)
                {
                    <option value="@opt.Value">@opt.Text</option>
                }
            </select>
        </td>
        <td class="py-2 px-4">
            <input type="number" name="Invoice.Items[{id}].Quantity" class="calc-input quantity-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="1" min="0.01" step="any" required />
        </td>
        <td class="py-2 px-4">
            <input type="number" name="Invoice.Items[{id}].UnitPrice" class="calc-input price-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="0" min="0" step="any" required />
            <p class="price-source mt-1 text-xs text-slate-500"></p>
        </td>
        <td class="py-2 px-4">
            <input type="number" name="Invoice.Items[{id}].DiscountRate" class="calc-input discount-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="0" min="0" max="100" step="any" />
        </td>
        <td class="py-2 px-4">
            <input type="number" name="Invoice.Items[{id}].VatRate" class="calc-input vat-input w-full bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2 dark:bg-slate-800 dark:border-slate-600 dark:text-white" value="@Model.DefaultVatRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="any" />
        </td>
        <td class="py-2 px-4 text-right font-semibold text-slate-800 dark:text-white row-total">
            0.00
        </td>
        <td class="py-2 px-4 text-center">
            <button type="button" class="remove-row-btn text-slate-400 hover:text-red-500 transition-colors">
                <span class="material-icons-round text-lg">delete</span>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    <script src="/Pages/Invoices/Create.js"></script>
}
