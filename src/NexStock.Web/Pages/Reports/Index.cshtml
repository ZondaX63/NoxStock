@page
@using Microsoft.AspNetCore.Mvc.Localization
@model NexStock.Web.Pages.Reports.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Raporlar";
}

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white">Gelişmiş Raporlar</h2>
        <p class="text-sm text-slate-500 mt-1">İşletmenizin performansını analiz edin ve dışa aktarın.</p>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- Rapor Kartı 1 -->
    <div class="card p-6 shadow-lg shadow-slate-200/50 dark:shadow-none hover:border-indigo-300 dark:hover:border-indigo-600 transition-colors cursor-pointer group flex flex-col">
        <div class="w-14 h-14 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <span class="material-icons-round text-2xl">point_of_sale</span>
        </div>
        <h3 class="text-lg font-bold text-slate-800 dark:text-white">Satış Raporları</h3>
        <p class="text-sm text-slate-500 mt-2 mb-6 flex-1">Günlük, haftalık ve aylık bazda en çok satan ürünler, kasiyer performansları ve ciro analizleri.</p>
        <button class="text-indigo-600 dark:text-indigo-400 font-semibold text-sm flex items-center group-hover:underline">
            Raporu Görüntüle <span class="material-icons-round text-sm ml-1">arrow_forward</span>
        </button>
    </div>

    <!-- Rapor Kartı 2 -->
    <div class="card p-6 shadow-lg shadow-slate-200/50 dark:shadow-none hover:border-emerald-300 dark:hover:border-emerald-600 transition-colors cursor-pointer group flex flex-col">
        <div class="w-14 h-14 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <span class="material-icons-round text-2xl">account_balance_wallet</span>
        </div>
        <h3 class="text-lg font-bold text-slate-800 dark:text-white">Finans ve Kasa Raporları</h3>
        <p class="text-sm text-slate-500 mt-2 mb-6 flex-1">Nakit akışı, tahsilatlar, ödemeler ve dönemsel kâr-zarar (P&L) durumunuzu anlık görün.</p>
        <button class="text-emerald-600 dark:text-emerald-400 font-semibold text-sm flex items-center group-hover:underline">
            Raporu Görüntüle <span class="material-icons-round text-sm ml-1">arrow_forward</span>
        </button>
    </div>

    <!-- Rapor Kartı 3 -->
    <div class="card p-6 shadow-lg shadow-slate-200/50 dark:shadow-none hover:border-orange-300 dark:hover:border-orange-600 transition-colors cursor-pointer group flex flex-col">
        <div class="w-14 h-14 bg-orange-100 dark:bg-orange-900/50 text-orange-600 dark:text-orange-400 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <span class="material-icons-round text-2xl">inventory_2</span>
        </div>
        <h3 class="text-lg font-bold text-slate-800 dark:text-white">Stok ve Depo Raporları</h3>
        <p class="text-sm text-slate-500 mt-2 mb-6 flex-1">Eriyen stoklar, envanter değeri, kritik seviyedeki ürünler ve hareket logları.</p>
        <button class="text-orange-600 dark:text-orange-400 font-semibold text-sm flex items-center group-hover:underline">
            Raporu Görüntüle <span class="material-icons-round text-sm ml-1">arrow_forward</span>
        </button>
    </div>

</div>
