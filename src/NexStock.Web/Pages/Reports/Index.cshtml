@page
@model NexStock.Web.Pages.Reports.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Raporlar";
}

<div class="mb-7 flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
    <div><h2 class="text-2xl font-bold text-slate-800 dark:text-white">Operasyonel Raporlar</h2><p class="mt-1 text-sm text-slate-500">Belge, stok ve finans hareketlerinden hesaplanan TL eşdeğeri dönem görünümü.</p></div>
    <form method="get" class="flex flex-wrap items-end gap-3">
        <div><label asp-for="DateFrom" class="mb-1 block text-xs font-medium text-slate-500">Başlangıç</label><input asp-for="DateFrom" type="date" class="report-input" /></div>
        <div><label asp-for="DateTo" class="mb-1 block text-xs font-medium text-slate-500">Bitiş</label><input asp-for="DateTo" type="date" class="report-input" /></div>
        <button type="submit" class="inline-flex h-10 items-center gap-2 rounded-md bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700"><span class="material-icons-round text-base">filter_alt</span>Uygula</button>
    </form>
</div>

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="report-stat"><span>Satışlar</span><strong>@Model.Money(Model.Report.Summary.Sales)</strong></div>
    <div class="report-stat"><span>Alışlar</span><strong>@Model.Money(Model.Report.Summary.Purchases)</strong></div>
    <div class="report-stat"><span>Operasyonel gelir</span><strong class="text-emerald-600">@Model.Money(Model.Report.Summary.Income)</strong></div>
    <div class="report-stat"><span>Operasyonel gider</span><strong class="text-rose-600">@Model.Money(Model.Report.Summary.Expense)</strong></div>
    <div class="report-stat"><span>Tahmini brüt kâr</span><strong class="text-emerald-600">@Model.Money(Model.Report.Summary.GrossProfitEstimate)</strong></div>
    <div class="report-stat"><span>Net nakit akışı</span><strong class="@(Model.Report.Summary.NetCashFlow < 0 ? "text-rose-600" : "text-emerald-600")">@Model.Money(Model.Report.Summary.NetCashFlow)</strong></div>
    <div class="report-stat"><span>Müşteri alacakları</span><strong>@Model.Money(Model.Report.Summary.Receivables)</strong></div>
    <div class="report-stat"><span>Tedarikçi borçları</span><strong>@Model.Money(Model.Report.Summary.Payables)</strong></div>
    <div class="report-stat"><span>Stok maliyet değeri</span><strong>@Model.Money(Model.Report.Summary.InventoryCostValue)</strong></div>
    <div class="report-stat"><span>Kritik stok</span><strong class="@(Model.Report.Summary.CriticalStockCount > 0 ? "text-rose-600" : "text-emerald-600")">@Model.Report.Summary.CriticalStockCount ürün</strong></div>
</div>

<div class="grid gap-6 xl:grid-cols-2">
    <section class="report-section">
        <div class="report-section-head"><h3>Kasa ve Banka Akışı</h3><span>@Model.Report.DateFrom.ToString("dd.MM.yyyy") - @Model.Report.DateTo.ToString("dd.MM.yyyy")</span></div>
        <div class="overflow-x-auto"><table class="report-table"><thead><tr><th>Hesap</th><th>Tür</th><th class="text-right">Giriş</th><th class="text-right">Çıkış</th><th class="text-right">Net</th><th class="text-right">Bakiye</th></tr></thead><tbody>
        @foreach (var account in Model.Report.Accounts)
        {
            <tr><td><strong>@account.Name</strong><small>@account.Currency</small></td><td>@account.Type</td><td class="text-right text-emerald-600">@Model.Money(account.Inflow)</td><td class="text-right text-rose-600">@Model.Money(account.Outflow)</td><td class="text-right">@Model.Money(account.NetFlow)</td><td class="text-right font-semibold">@Model.Money(account.Balance)</td></tr>
        }
        @if (!Model.Report.Accounts.Any()) { <tr><td colspan="6" class="report-empty">Kayıt bulunamadı.</td></tr> }
        </tbody></table></div>
    </section>

    <section class="report-section">
        <div class="report-section-head"><h3>Cari Alacak ve Borç</h3><span>Mevcut bakiye</span></div>
        <div class="overflow-x-auto"><table class="report-table"><thead><tr><th>Cari</th><th>Tip</th><th class="text-right">Satış</th><th class="text-right">Alış</th><th class="text-right">Bakiye</th></tr></thead><tbody>
        @foreach (var partner in Model.Report.BusinessPartners)
        {
            <tr><td><strong>@partner.Name</strong><small>@partner.Currency</small></td><td>@partner.Type</td><td class="text-right">@Model.Money(partner.Sales)</td><td class="text-right">@Model.Money(partner.Purchases)</td><td class="text-right font-semibold @(partner.Balance < 0 ? "text-rose-600" : "text-emerald-600")">@Model.Money(partner.Balance)</td></tr>
        }
        @if (!Model.Report.BusinessPartners.Any()) { <tr><td colspan="5" class="report-empty">Kayıt bulunamadı.</td></tr> }
        </tbody></table></div>
    </section>

    <section class="report-section">
        <div class="report-section-head"><h3>Yaşlandırma</h3><span>Açık faturalar</span></div>
        <div class="overflow-x-auto"><table class="report-table"><thead><tr><th>Vade dilimi</th><th class="text-right">Alacak</th><th class="text-right">Borç</th></tr></thead><tbody>
        @foreach (var item in Model.Report.Aging)
        {
            <tr><td><strong>@item.Bucket</strong></td><td class="text-right text-emerald-600">@Model.Money(item.Receivables)</td><td class="text-right text-rose-600">@Model.Money(item.Payables)</td></tr>
        }
        </tbody></table></div>
    </section>

    <section class="report-section">
        <div class="report-section-head"><h3>KDV Özeti</h3><span>Dönem içi onaylı belgeler</span></div>
        <div class="overflow-x-auto"><table class="report-table"><thead><tr><th>KDV oranı</th><th class="text-right">Hesaplanan</th><th class="text-right">İndirilecek</th><th class="text-right">Net</th></tr></thead><tbody>
        @foreach (var item in Model.Report.VatRates)
        {
            <tr><td><strong>%@item.VatRate</strong></td><td class="text-right">@Model.Money(item.SalesVat)</td><td class="text-right">@Model.Money(item.PurchaseVat)</td><td class="text-right font-semibold">@Model.Money(item.NetVat)</td></tr>
        }
        @if (!Model.Report.VatRates.Any()) { <tr><td colspan="4" class="report-empty">Kayıt bulunamadı.</td></tr> }
        </tbody></table></div>
    </section>
</div>

<section class="report-section mt-6">
    <div class="report-section-head"><h3>Ürün Kârlılığı</h3><span>Tahmini maliyet, ürün kartındaki güncel alış fiyatına göre hesaplanır.</span></div>
    <div class="overflow-x-auto"><table class="report-table"><thead><tr><th>Ürün</th><th class="text-right">Satılan</th><th class="text-right">Satış</th><th class="text-right">Tahmini maliyet</th><th class="text-right">Brüt kâr</th><th class="text-right">Marj</th></tr></thead><tbody>
    @foreach (var item in Model.Report.ProductProfitability)
    {
        <tr><td><strong>@item.Name</strong><small>@item.Sku</small></td><td class="text-right">@Model.Quantity(item.SoldQuantity)</td><td class="text-right">@Model.Money(item.SalesAmount)</td><td class="text-right">@Model.Money(item.EstimatedCost)</td><td class="text-right font-semibold @(item.GrossProfitEstimate < 0 ? "text-rose-600" : "text-emerald-600")">@Model.Money(item.GrossProfitEstimate)</td><td class="text-right">%@item.GrossMarginPercent</td></tr>
    }
    @if (!Model.Report.ProductProfitability.Any()) { <tr><td colspan="6" class="report-empty">Seçili dönemde satış bulunamadı.</td></tr> }
    </tbody></table></div>
</section>

<div class="grid gap-6 xl:grid-cols-2 mt-6">
    <section class="report-section">
        <div class="report-section-head"><h3>Stok ve Kritik Seviye</h3><span>Mevcut stok</span></div>
        <div class="max-h-[32rem] overflow-auto"><table class="report-table"><thead><tr><th>Ürün</th><th class="text-right">Stok</th><th class="text-right">Kritik</th><th class="text-right">Maliyet değeri</th></tr></thead><tbody>
        @foreach (var item in Model.Report.Stocks)
        {
            <tr><td><strong>@item.Name</strong><small>@item.Sku</small></td><td class="text-right font-semibold @(item.IsCritical ? "text-rose-600" : "")">@Model.Quantity(item.Quantity) @item.Unit</td><td class="text-right">@Model.Quantity(item.CriticalStockLevel)</td><td class="text-right">@Model.Money(item.CostValue)</td></tr>
        }
        @if (!Model.Report.Stocks.Any()) { <tr><td colspan="4" class="report-empty">Kayıt bulunamadı.</td></tr> }
        </tbody></table></div>
    </section>

    <section class="report-section">
        <div class="report-section-head"><h3>Stok Hareketleri</h3><span>Son 100 hareket</span></div>
        <div class="max-h-[32rem] overflow-auto"><table class="report-table"><thead><tr><th>Tarih</th><th>Ürün</th><th>Tip</th><th class="text-right">Miktar</th><th class="text-right">Bakiye</th></tr></thead><tbody>
        @foreach (var item in Model.Report.StockMovements)
        {
            <tr><td>@item.Date.ToString("dd.MM.yyyy HH:mm")</td><td><strong>@item.ProductName</strong><small>@item.Description</small></td><td>@item.Type</td><td class="text-right @(item.Quantity < 0 ? "text-rose-600" : "text-emerald-600")">@Model.Quantity(item.Quantity)</td><td class="text-right">@Model.Quantity(item.BalanceAfter)</td></tr>
        }
        @if (!Model.Report.StockMovements.Any()) { <tr><td colspan="5" class="report-empty">Seçili dönemde hareket yok.</td></tr> }
        </tbody></table></div>
    </section>
</div>
